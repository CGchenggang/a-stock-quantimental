# -*- coding: utf-8 -*-\n3\t\"\"\"\n4\tglobal_liquidity_radar.py — 全球流动性雷达模块 (v0.86)\n5\t======================================================\n6\t\n7\ta-stock-quantimental v0.86 新增模块\n8\t\n9\t监测全球流动性风险，核心关注日元套利交易(carry trade)风险。\n10\t\n11\t监测维度:\n12\t  1. fx_carry_risk - 日元套利交易风险（核心）\n13\t  2. usd_stress - 美元流动性压力\n14\t  3. cross_asset_anomaly - 跨资产异常信号\n15\t  4. historical_pattern - 历史危机模式匹配\n16\t\n17\t数据源（14项，78%自动化）:\n18\t  ✅ USD/JPY, USD/CNH, DXY (汇率)\n19\t  ✅ 中美国债收益率 (利率)\n20\t  ✅ COMEX黄金, WTI原油, COMEX铜 (商品)\n21\t  ✅ 费城半导体, 日经ETF, 韩国ETF, VXX (股指)\n22\t  ✅ CFTC日元净持仓 (持仓)\n23\t\n24\t评级输出:\n25\t  🟢 GREEN (0) - 正常交易\n26\t  🟡 YELLOW (1) - 注意但不减仓\n27\t  🟠 ORANGE (2) - 成长股仓位-10%，止损收紧1%\n28\t  🔴 RED (3) - 总仓位-20%，禁止追高，9:30-10:00观察窗口\n29\t\n30\t使用方式:\n31\t  python scripts/global_liquidity_radar.py\n32\t  python scripts/global_liquidity_radar.py --push  # 推送飞书\n33\t\"\"\"\n34\t\n35\tfrom __future__ import annotations\n36\t\n37\timport json\n38\timport sys\n39\timport time\n40\tfrom datetime import datetime, timedelta, date"}]},"uuid":"b04a424b-96b1-4b0d-9177-ac6360d67c68","timestamp":"2026-08-17T00:38:17.777Z","toolUseResult":{"type":"text","file":{"filePath":"F:\\软件-图书仓库\\skills\\a-stock-quantimental\\scripts\\global_liquidity_radar.py","content":"#!/usr/bin/env python3\n
