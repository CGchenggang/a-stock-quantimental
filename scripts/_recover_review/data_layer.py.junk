# -*- coding: utf-8 -*-\n2\t\"\"\"统一数据采集层 (data_layer.py)\n3\t\n4\t所有 AkShare / yfinance 调用的唯一入口。设计原则：\n5\t1. 每个函数 try-except 包裹，失败返回带 error 字段的结构，永不抛异常中断主流程。\n6\t2. 实时类数据带本地缓存（TTL），避免高频拉取被封。\n7\t3. 被限流接口(_em 实时行情)自动降级到新浪接口。\n8\t4. v0.84 新增熔断器(Circuit Breaker)：连续失败3次自动隔离该源，15分钟后试探恢复，\n9\t   避免已知故障源反复超时浪费盘前流水线耗时。状态持久化到 cache/circuit_breaker.json。\n10\t\n11\t可用接口（已验证 v1.18.64）：\n12\t- stock_zh_a_spot        新浪全市场实时行情(5527只,~40s) ★主实时源\n13\t- stock_zh_a_hist        个股日K(算MA) ★稳定\n14\t- stock_zh_index_daily   指数日K(沪深300/创业板) ★稳定\n15\t- stock_sector_spot      新浪行业板块涨跌排名 ★稳定\n16\t- stock_intraday_em      分时(不稳定,需重试) ★分时源\n17\t- stock_us_daily         美股日K(NVDA/AMD/TSLA) ★稳定\n18\t- bond_zh_us_rate        中美国债收益率 ★稳定\n19\t- currency_boc_sina      央行汇率 ★稳定\n20\t- tool_trade_date_hist_sina  交易日历 ★稳定\n21\t\n22\t被限流接口（不可依赖）：所有 _em 后缀实时接口、资金流接口、个股信息接口\n23\t\"\"\"\n24\tfrom __future__ import annotations\n25\t\n26\timport json\n27\timport os\n28\timport time\n29\timport warnings\n30\tfrom datetime import datetime, date, timedelta\n31\tfrom pathlib import Path\n32\tfrom typing import Any, Optional\n33\t\n34\twarnings.filterwarnings(\"ignore\")\n35\t\n36\t# ---- 路径 ----\n37\tSCRIPT_DIR = Path(__file__).resolve().parent\n38\tSKILL_DIR = SCRIPT_DIR.parent\n39\tDATABASE_DIR = SKILL_DIR / \"database\"\n40\tCACHE_DIR = DATABASE_DIR / \"cache\"\n41\tCACHE_DIR.mkdir(parents=True, exist_ok=True)\n42\t\n43\t\n44\t# =========================================================\n45\t# 缓存机制\n46\t# =========================================================\n47\tdef _cache_path(key: str) -> Path:\n48\t    safe = key.replace(\"/\", \"_\").replace(\"\\\\\", \"_\").replace(\":\", \"_\")\n49\t    return CACHE_DIR / f\"{safe}.json\"\n50\t\n51\t\n52\tdef _cache_get(key: str, ttl_seconds: int) -> Optional[Any]:\n53\t    \"\"\"读缓存。过期或不存在返回 None。\"\"\"\n54\t    p = _cache_path(key)\n55\t    if not p.exists():\n56\t        return None\n57\t    try:\n58\t        meta = json.loads(p.read_text(encoding=\"utf-8\"))\n59\t        age = time.time() - meta.get(\"ts\", 0)\n60\t        if age > ttl_seconds:\n61\t            return None\n62\t        return meta.get(\"data\")\n63\t    except Exception:\n64\t        return None\n65\t\n66\t\n67\tdef _cache_set(key: str, data: Any) -> None:\n68\t    p = _cache_path(key)\n69\t    try:\n70\t        p.write_text(\n71\t            json.dumps({\"ts\": time.time(), \"data\": data}, ensure_ascii=False, default=str),\n72\t            encoding=\"utf-8\",\n73\t        )\n74\t    except Exception:\n75\t        pass\n76\t\n77\t\n78\t# =========================================================\n79\t# 熔断器（Circuit Breaker）\n80\t# =========================================================\n81\t# 模块级状态：追踪每个数据源的连续失败次数，连续失败达阈值后自动隔离，\n82\t# 到期后试探恢复。避免已知故障源反复超时浪费盘前流水线耗时。\n83\tCB_PATH = CACHE_DIR / \"circuit_breaker.json\"\n84\tCB_FAILURE_THRESHOLD = 3       # 连续失败次数触发熔断\n85\tCB_RECOVERY_TIMEOUT = 900      # 15分钟后试探恢复（秒）\n86\t_cb_state: dict = {}\n87\t\n88\t\n89\tdef _cb_load():\n90\t    \"\"\"从文件加载熔断器状态（进程重启后恢复）。\"\"\"\n91\t    global _cb_state\n92\t    if not _cb_state and CB_PATH.exists():\n93\t        try:\n94\t            _cb_state = json.loads(CB_PATH.read_text(encoding=\"utf-8\"))\n95\t        except Exception:\n96\t            _cb_state = {}\n97\t\n98\t\n99\tdef _cb_save():\n100\t    \"\"\"持久化熔断器状态到文件。\"\"\"\n101\t    try:\n102\t        CB_PATH.write_text(\n103\t            json.dumps(_cb_state, ensure_ascii=False), encoding=\"utf-8\"\n104\t        )\n105\t    except Exception:\n106\t        pass\n107\t\n108\t\n109\tdef _cb_is_open(source: str) -> bool:\n110\t    \"\"\"检查数据源是否处于熔断状态。True=熔断中，应跳过该源。\"\"\"\n111\t    _cb_load()\n112\t    cb = _cb_state.get(source)\n113\t    if not cb or cb.get(\"failures\", 0) < CB_FAILURE_THRESHOLD:\n114\t        return False\n115\t    elapsed = time.time() - cb.get(\"opened_at\", 0)\n116\t    if elapsed > CB_RECOVERY_TIMEOUT:\n117\t        # 超时，允许一次试探\n118\t        return False\n119\t    return True\n120\t\n121\t\n122\tdef _cb_record_success(source: str):\n123\t    \"\"\"数据源调用成功：重置失败计数。\"\"\"\n124\t    _cb_load()\n125\t    if source in _cb_state and _cb_state[source].get(\"failures\", 0) > 0:\n126\t        print(f\"[CB] {source} 恢复，重置计数\")\n127\t    _cb_state[source] = {\"failures\": 0, \"opened_at\": 0}\n128\t    _cb_save()\n129\t\n130\t\n131\tdef _cb_record_failure(source: str):\n132\t    \"\"\"数据源调用失败：计数+1，达阈值则开路熔断。\"\"\"\n133\t    _cb_load()\n134\t    cb = _cb_state.get(source, {\"failures\": 0, \"opened_at\": 0})\n135\t    cb[\"failures\"] = cb.get(\"failures\", 0) + 1\n136\t    if cb[\"failures\"] >= CB_FAILURE_THRESHOLD and cb.get(\"opened_at\", 0) == 0:\n137\t        cb[\"opened_at\"] = time.time()\n138\t        print(f\"[CB] {source} 熔断！连续失败{cb['failures']}次，{CB_RECOVERY_TIMEOUT//60}分钟后试探\")\n139\t    _cb_state[source] = cb\n140\t    _cb_save()\n141\t\n142\t\n143\tdef _safe_call(name: str, fn):\n144\t    \"\"\"安全调用：捕获异常，返回 (ok, data, error)。\"\"\"\n145\t    try:\n146\t        return True, fn(), \"\"\n147\t    except Exception as e:\n148\t        return False, None, f\"{type(e).__name__}: {str(e)[:120]}\"\n149\t\n150\t\n151\tdef _ak():\n152\t    \"\"\"惰性导入 akshare，失败时给出明确错误。\"\"\"\n153\t    import akshare as ak\n154\t    return ak\n155\t\n156\t\n157\t# =========================================================\n158\t# 1. A股实时行情（新浪全市场，主实时源）\n159\t# =========================================================\n160\t_REALTIME_TTL = 300  # 5分钟缓存\n161\t\n162\t\n163\tdef get_realtime_quotes(force_refresh: bool = False) -> dict:\n164\t    \"\"\"新浪全市场实时行情。返回 {code: row_dict, ...}。\n165\t\n166\t    shape ~5527只，约40秒。缓存5分钟。\n167\t    字段：代码/名称/最新价/涨跌幅/换手率/量比/成交额 等\n168\t    \"\"\"\n169\t    if not force_refresh:\n170\t        cached = _cache_get(\"realtime_all\", _REALTIME_TTL)\n171\t        if cached is not None:\n172\t            return cached\n173\t\n174\t    ak = _ak()\n175\t    # 熔断检查：新浪全市场行情\n176\t    if _cb_is_open(\"sina_spot\"):\n177\t        ok, df, err = False, None, \"circuit_open: sina_spot\"\n178\t    else:\n179\t        ok, df, err = _safe_call(\"stock_zh_a_spot\", ak.stock_zh_a_spot)\n180\t        _cb_record_success(\"sina_spot\") if ok else _cb_record_failure(\"sina_spot\")\n181\t    if not ok or df is None or df.empty:\n182\t        # 降级：尝试东方财富(可能被限流)\n183\t        if _cb_is_open(\"stock_zh_a_spot_em\"):\n184\t            ok2, df2, err2 = False, None, \"circuit_open: stock_zh_a_spot_em\"\n185\t        else:\n186\t            ok2, df2, err2 = _safe_call(\"stock_zh_a_spot_em\", ak.stock_zh_a_spot_em)\n187\t            _cb_record_success(\"stock_zh_a_spot_em\") if ok2 else _cb_record_failure(\"stock_zh_a_spot_em\")\n188\t        if not ok2 or df2 is None or df2.empty:\n189\t            return {\"ok\": False, \"error\": f\"sina:{err} | em:{err2}\", \"quotes\": {}}\n190\t        df = df2\n191\t\n192\t    quotes = {}\n193\t    for _, row in df.iterrows():\n194\t        raw_code = str(row.get(\"代码\", \"\")).strip()\n195\t        if not raw_code:\n196\t            continue\n197\t        # 新浪返回带前缀(sz300502)，同时存纯数字键(300502)方便按数字代码查询\n198\t        digits = _clean_code(raw_code)\n199\t        entry = {\n200\t            \"code\": digits,\n201\t            \"raw_code\": raw_code,\n202\t            \"name\": str(row.get(\"名称\", \"\")),\n203\t            \"price\": _f(row.get(\"最新价\")),\n204\t            \"pct\": _f(row.get(\"涨跌幅\")),\n205\t            \"change\": _f(row.get(\"涨跌额\")),\n206\t            \"prev_close\": _f(row.get(\"昨收\")),\n207\t            \"open\": _f(row.get(\"今开\")),\n208\t            \"high\": _f(row.get(\"最高\")),\n209\t            \"low\": _f(row.get(\"最低\")),\n210\t            \"volume\": _f(row.get(\"成交量\")),\n211\t            \"amount\": _f(row.get(\"成交额\")),\n212\t            \"turnover\": _f(row.get(\"换手率\")),\n213\t            \"volume_ratio\": _f(row.get(\"量比\")),  # 量比\n214\t        }\n215\t        quotes[digits] = entry  # 主键用纯数字\n216\t        quotes[raw_code] = entry  # 兼容带前缀查询\n217\t    result = {\"ok\": True, \"error\": \"\", \"count\": len(quotes), \"quotes\": quotes, \"ts\": datetime.now().isoformat(timespec=\"seconds\")}\n218\t    _cache_set(\"realtime_all\", result)\n219\t    return result\n220\t\n221\t\n222\tdef get_stock_realtime(code: str) -> dict:\n223\t    \"\"\"单股实时行情。三级兜底：\n224\t    1) 新浪全市场缓存(秒级,盘中最准) → 2) 分时接口 → 3) 日K收盘价(盘后/兜底)\n225\t\n226\t    特殊处理：新浪全市场在非交易时段(9:00前/15:30后)实时价返回0，\n227\t    此时自动用昨收价兜底并标注 source，避免下游显示0元误判。\n228\t    \"\"\"\n229\t    code = _clean_code(code)\n230\t    # 1) 全市场缓存\n231\t    all_q = get_realtime_quotes()\n232\t    if all_q.get(\"ok\") and code in all_q[\"quotes\"]:\n233\t        q = dict(all_q[\"quotes\"][code])\n234\t        q[\"ok\"] = True\n235\t        # 检测实时价为0(非交易时段新浪返回0)，用昨收兜底\n236\t        if not q.get(\"price\") or q.get(\"price\") == 0:\n237\t            prev = q.get(\"prev_close\")\n238\t            if prev and prev > 0:\n239\t                q[\"price\"] = prev\n240\t                # 盘前/盘后兜底：用上一个交易日的实际涨跌幅（而非0.0）\n241\t                # 避免诊断时所有股票pct=0与指数比较后全部显示\"显著弱于大盘\"\n242\t                fallback_pct = 0.0\n243\t                try:\n244\t                    _hist = get_stock_hist(code, 5)\n245\t                    if _hist.get(\"ok\") and _hist.get(\"latest\", {}).get(\"pct\") is not None:\n246\t                        fallback_pct = _hist[\"latest\"][\"pct\"]\n247\t                except Exception:\n248\t                    pass\n249\t                q[\"pct\"] = fallback_pct\n250\t                q[\"source\"] = \"prev_close_fallback\"\n251\t                q[\"_note\"] = f\"非交易时段实时价为0，已用昨收{prev}兜底，pct取自上一交易日\"\n252\t            else:\n253\t                q[\"source\"] = \"sina_spot_zero\"\n254\t                q[\"_note\"] = \"非交易时段，实时价为0且无昨收，数据待开盘后更新\"\n255\t        else:\n256\t            q[\"source\"] = \"sina_spot\"\n257\t        return q\n258\t\n259\t    # 2) 分时接口兜底\n260\t    intra = get_intraday(code)\n261\t    if intra.get(\"ok\") and intra.get(\"ticks\"):\n262\t        last = intra[\"ticks\"][-1]\n263\t        if last.get(\"price\") and last.get(\"price\") > 0:\n264\t            return {\n265\t                \"ok\": True,\n266\t                \"code\": code,\n267\t                \"price\": last.get(\"price\"),\n268\t                \"vwap\": intra.get(\"vwap\"),\n269\t                \"source\": \"intraday_fallback\",\n270\t            }\n271\t\n272\t    # 3) 日K收盘价兜底（最稳定，但仅反映上一交易日收盘）\n273\t    hist = get_stock_hist(code, 60)\n274\t    if hist.get(\"ok\"):\n275\t        return {\n276\t            \"ok\": True,\n277\t            \"code\": code,\n278\t            \"name\": \"\",\n279\t            \"price\": hist[\"latest\"][\"close\"],\n280\t            \"pct\": hist[\"latest\"][\"pct\"],\n281\t            \"source\": \"daily_close_fallback\",\n282\t            \"_note\": \"实时行情接口不可用，使用上一交易日收盘价\",\n283\t        }\n284\t    return {\"code\": code, \"ok\": False, \"error\": \"all realtime sources failed\"}\n285\t\n286\t\n287\t# =========================================================\n288\t# 2. 个股日K + 均线 + 量能\n289\t# =========================================================\n290\tdef get_stock_hist(code: str, days: int = 120) -> dict:\n291\t    \"\"\"个股日K，并计算 MA5/10/20/60、量能比LR。\n292\t\n293\t    主通道：新浪 stock_zh_a_daily（需 sz/sh 前缀，英文列名，稳定）。\n294\t    备用：东方财富 stock_zh_a_hist（中文列名，常被限流）。\n295\t\n296\t    返回 {ok, code, latest_date, latest{}, ma5/ma10/ma20/ma60, vol_ma20, lr,\n297\t          recent_high20, recent_low20, closes_tail, kline_count, error}\n298\t    \"\"\"\n299\t    code = _clean_code(code)\n300\t    cache_key = f\"hist_{code}_{days}\"\n301\t    cached = _cache_get(cache_key, 3600)  # 日K缓存1小时\n302\t    if cached is not None:\n303\t        return cached\n304\t\n305\t    ak = _ak()\n306\t    # 加 sz/sh 前缀（新浪要求）：6开头沪市，其余深市\n307\t    sina_symbol = (\"sh\" if code.startswith(\"6\") else \"sz\") + code\n308\t\n309\t    df = None\n310\t    err = \"\"\n311\t    # 熔断检查：新浪日K\n312\t    sina_open = _cb_is_open(\"stock_zh_a_daily\")\n313\t    # 主通道：新浪日K（英文列名 date/open/high/low/close/volume/amount）\n314\t    for attempt in range(3):\n315\t        if sina_open:\n316\t            err = \"circuit_open: stock_zh_a_daily\"\n317\t            break\n318\t        ok, d, err = _safe_call(\"stock_zh_a_daily\", lambda: ak.stock_zh_a_daily(symbol=sina_symbol, adjust=\"qfq\"))\n319\t        if ok and d is not None and not d.empty:\n320\t            _cb_record_success(\"stock_zh_a_daily\")\n321\t            df = d\n322\t            break\n323\t        _cb_record_failure(\"stock_zh_a_daily\")\n324\t        time.sleep(1.5)\n325\t\n326\t    # 备用：东方财富（中文列名 日期/开盘/收盘...）——常被限流，仅兜底\n327\t    if df is None:\n328\t        if _cb_is_open(\"stock_zh_a_hist\"):\n329\t            err2 = \"circuit_open: stock_zh_a_hist\"\n330\t        else:\n331\t            ok2, df2, err2 = _safe_call(\"stock_zh_a_hist\", lambda: ak.stock_zh_a_hist(symbol=code, period=\"daily\", adjust=\"qfq\"))\n332\t            _cb_record_success(\"stock_zh_a_hist\") if (ok2 and df2 is not None and not df2.empty) else _cb_record_failure(\"stock_zh_a_hist\")\n333\t            if ok2 and df2 is not None and not df2.empty:\n334\t                df = df2\n335\t\n336\t    if df is None or df.empty:\n337\t        return {\"ok\": False, \"error\": f\"sina:{err} | em:fallback_failed\", \"code\": code}\n338\t\n339\t    # 统一列名（兼容新浪英文 / 东方财富中文）\n340\t    colmap = {\"date\": \"date\", \"日期\": \"date\", \"open\": \"open\", \"开盘\": \"open\",\n341\t              \"close\": \"close\", \"收盘\": \"close\", \"high\": \"high\", \"最高\": \"high\",\n342\t              \"low\": \"low\", \"最低\": \"low\", \"volume\": \"volume\", \"成交量\": \"volume\",\n343\t              \"amount\": \"amount\", \"成交额\": \"amount\"}\n344\t    df = df.rename(columns={k: v for k, v in colmap.items() if k in df.columns})\n345\t    df = df.sort_values(\"date\").reset_index(drop=True)\n346\t\n347\t    # 【当日数据修正】检查最后一条日期是否是今天，如果不是则用实时行情覆盖\n348\t    today_str = datetime.now().strftime(\"%Y-%m-%d\")\n349\t    last_date = str(df.iloc[-1][\"date\"])[:10]  # 取前10字符（YYYY-MM-DD）\n350\t    \n351\t    if last_date != today_str:\n352\t        # 日K数据不是今天，尝试从实时行情获取今日收盘数据\n353\t        realtime = get_realtime_quotes()\n354\t        if realtime.get(\"ok\") and code in realtime[\"quotes\"]:\n355\t            q = realtime[\"quotes\"][code]\n356\t            if q.get(\"price\") and q[\"price\"] > 0:  # 有有效价格\n357\t                # 追加今日数据\n358\t                import pandas as pd\n359\t                today_row = pd.DataFrame([{\n360\t                    \"date\": today_str,\n361\t                    \"open\": q.get(\"open\") or q[\"price\"],\n362\t                    \"high\": q.get(\"high\") or q[\"price\"],\n363\t                    \"low\": q.get(\"low\") or q[\"price\"],\n364\t                    \"close\": q[\"price\"],\n365\t                    \"volume\": q.get(\"volume\") or 0,\n366\t                }])\n367\t                df = pd.concat([df, today_row], ignore_index=True)\n368\t\n369\t    closes = df[\"close\"].astype(float).tolist()\n370\t    highs = df[\"high\"].astype(float).tolist()\n371\t    lows = df[\"low\"].astype(float).tolist()\n372\t    vols = df[\"volume\"].astype(float).tolist()\n373\t\n374\t    def ma(arr, n):\n375\t        return round(sum(arr[-n:]) / n, 2) if len(arr) >= n else None\n376\t\n377\t    vol_ma20 = sum(vols[-20:]) / 20 if len(vols) >= 20 else None\n378\t    latest = df.iloc[-1]\n379\t    prev = df.iloc[-2] if len(df) >= 2 else None\n380\t    # 新浪无涨跌幅字段，自行计算\n381\t    pct = round((latest[\"close\"] - prev[\"close\"]) / prev[\"close\"] * 100, 2) if prev is not None else None\n382\t\n383\t    result = {\n384\t        \"ok\": True,\n385\t        \"code\": code,\n386\t        \"latest_date\": str(latest[\"date\"]),\n387\t        \"latest\": {\n388\t            \"open\": _f(latest[\"open\"]),\n389\t            \"close\": _f(latest[\"close\"]),\n390\t            \"high\": _f(latest[\"high\"]),\n391\t            \"low\": _f(latest[\"low\"]),\n392\t            \"pct\": pct,\n393\t            \"volume\": int(latest[\"volume\"]) if latest[\"volume\"] == latest[\"volume\"] else 0,\n394\t            \"amount\": _f(latest.get(\"amount\")),\n395\t            \"turnover\": None,  # 新浪无换手率，留空\n396\t        },\n397\t        \"prev_close\": _f(prev[\"close\"]) if prev is not None else None,\n398\t        \"ma5\": ma(closes, 5),\n399\t        \"ma10\": ma(closes, 10),\n400\t        \"ma20\": ma(closes, 20),\n401\t        \"ma60\": ma(closes, 60),\n402\t        \"vol_ma20\": vol_ma20,\n403\t        \"lr\": round(vols[-1] / vol_ma20, 2) if vol_ma20 and vol_ma20 > 0 else None,  # 量能火控\n404\t        \"recent_high20\": max(highs[-20:]) if len(highs) >= 20 else None,\n405\t        \"recent_low20\": min(lows[-20:]) if len(lows) >= 20 else None,\n406\t        \"closes_tail\": [round(c, 2) for c in closes[-5:]],  # 近5日收盘\n407\t        \"closes60\": [round(c, 2) for c in closes[-60:]],  # 近60日收盘（布林带/黄金分割）\n408\t        \"highs60\": [round(h, 2) for h in highs[-60:]],  # 近60日最高\n409\t        \"lows60\": [round(l, 2) for l in lows[-60:]],  # 近60日最低\n410\t        \"kline_count\": len(df),\n411\t        # 新增：趋势股判断（解决均线回归偏见）\n412\t        \"trend_analysis\": is_trend_stock(closes, highs, vols),\n413\t    }\n414\t    _cache_set(cache_key, result)\n415\t    return result\n416\t\n417\t\n418\t# =========================================================\n419\t# 3. 分时数据 + VWAP(分时均线/黄线)\n420\t# =========================================================\n421\tdef get_intraday(code: str) -> dict:\n422\t    \"\"\"个股分时数据。计算今日 VWAP(分时均线/黄线)。\n423\t\n424\t    stock_intraday_em 不稳定，重试2次。\n425\t    v0.93 新增：盘中缓存4小时，盘后可复用当天最后有效数据。\n426\t    \"\"\"\n427\t    code = _clean_code(code)\n428\t    cache_key = f\"intraday_{code}\"\n429\t\n430\t    # 盘中缓存策略：交易时段缓存4小时，盘后缓存到次日开盘\n431\t    now = datetime.now()\n432\t    hour = now.hour\n433\t    minute = now.minute\n434\t    is_trading_hours = (9, 30) <= (hour, minute) <= (15, 0) and now.weekday() < 5\n435\t\n436\t    # 尝试读缓存\n437\t    cached = _cache_get(cache_key, max_age=14400 if is_trading_hours else 86400)  # 盘中4h，盘后24h\n438\t    if cached is not None:\n439\t        return cached\n440\t\n441\t    ak = _ak()\n442\t    df = None\n443\t    err = \"\"\n444\t    intraday_open = _cb_is_open(\"stock_intraday_em\")\n445\t    for attempt in range(2):\n446\t        if intraday_open:\n447\t            err = \"circuit_open: stock_intraday_em\"\n448\t            break\n449\t        ok, d, err = _safe_call(\"stock_intraday_em\", lambda: ak.stock_intraday_em(symbol=code))\n450\t        if ok and d is not None and not d.empty:\n451\t            _cb_record_success(\"stock_intraday_em\")\n452\t            df = d\n453\t            break\n454\t        _cb_record_failure(\"stock_intraday_em\")\n455\t        time.sleep(1)\n456\t    if df is None or df.empty:\n457\t        return {\"ok\": False, \"error\": err, \"code\": code}\n458\t\n459\t    # 列名：时间/成交价/手数/买卖盘性质\n460\t    prices = df[\"成交价\"].astype(float).tolist()\n461\t    hands = df[\"手数\"].astype(float).tolist()\n462\t    total_hand = sum(hands) if hands else 0\n463\t    vwap = sum(p * h for p, h in zip(prices, hands)) / total_hand if total_hand else None\n464\t\n465\t    # 解析买卖盘性质（\"买入\"/\"卖出\"/\"中性\"）\n466\t    buy_vol, sell_vol, neutral_vol = 0, 0, 0\n467\t    bs_col = \"买卖盘性质\" if \"买卖盘性质\" in df.columns else None\n468\t    bs_values = df[bs_col].astype(str).tolist() if bs_col else [\"\"] * len(df)\n469\t\n470\t    ticks = []\n471\t    for i, (t, p, h) in enumerate(zip(df[\"时间\"], prices, hands)):\n472\t        bs_raw = bs_values[i].strip() if i < len(bs_values) else \"\"\n473\t        h_int = int(h)\n474\t        # 归类买卖方向\n475\t        if \"买\" in bs_raw:\n476\t            buy_vol += h_int\n477\t            bs = \"B\"\n478\t        elif \"卖\" in bs_raw:\n479\t            sell_vol += h_int\n480\t            bs = \"S\"\n481\t        else:\n482\t            neutral_vol += h_int\n483\t            bs = \"N\"\n484\t        ticks.append({\"time\": str(t), \"price\": _f(p), \"hands\": h_int, \"bs\": bs})\n485\t\n486\t    result = {\n487\t        \"ok\": True,\n488\t        \"code\": code,\n489\t        \"vwap\": round(vwap, 2) if vwap else None,\n490\t        \"last_price\": prices[-1] if prices else None,\n491\t        \"last_time\": str(df[\"时间\"].iloc[-1]) if len(df) else None,\n492\t        \"ticks_count\": len(ticks),\n493\t        \"ticks\": ticks[-30:],  # 只保留末30条避免过大\n494\t        # v0.85 新增：买卖盘统计（用于筹码收集/派发分析）\n495\t        \"buy_vol\": buy_vol,\n496\t        \"sell_vol\": sell_vol,\n497\t        \"neutral_vol\": neutral_vol,\n498\t        \"has_bs_data\": bs_col is not None,\n499\t    }\n500\t\n501\t    # v0.93: 缓存分时数据，盘后可复用\n502\t    _cache_set(cache_key, result)\n503\t\n504\t    return result\n505\t\n506\t\n507\t# =========================================================\n508\t# 3.5 分时K线（新浪5分钟/1分钟K线）\n509\t# =========================================================\n510\tdef get_minute_kline(code: str, scale: int = 5, datalen: int = 20) -> dict:\n511\t    \"\"\"新浪分时K线数据（5分钟/1分钟）。\n512\t\n513\t    Args:\n514\t        code: 股票代码（6位数字）\n515\t        scale: K线周期，5=5分钟，1=1分钟，15=15分钟，30=30分钟，60=60分钟\n516\t        datalen: 获取条数（最后N条）\n517\t\n518\t    Returns:\n519\t        {ok, code, scale, klines: [{time, open, high, low, close, volume}, ...]}\n520\t\n521\t    数据源：新浪财经API，稳定可靠。\n522\t    \"\"\"\n523\t    code = _clean_code(code)\n524\t    cache_key = f\"min_kline_{code}_{scale}_{datalen}\"\n525\t    cached = _cache_get(cache_key, 60)  # 缓存1分钟\n526\t    if cached is not None:\n527\t        return cached\n528\t\n529\t    # 构造新浪API URL\n530\t    prefix = \"sh\" if code.startswith(\"6\") else \"sz\"\n531\t    symbol = f\"{prefix}{code}\"\n532\t    url = (\n533\t        f\"https://vip.stock.finance.sina.com.cn/quotes_service/api/json_v2.php/\"\n534\t        f\"CN_MarketData.getKLineData?symbol={symbol}&scale={scale}&ma=no&datalen={datalen}\"\n535\t    )\n536\t\n537\t    try:\n538\t        import requests\n539\t        resp = requests.get(url, timeout=10, headers={\n540\t            \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\n541\t            \"Referer\": \"https://finance.sina.com.cn/\"\n542\t        })\n543\t        if resp.status_code != 200:\n544\t            return {\"ok\": False, \"error\": f\"HTTP {resp.status_code}\", \"code\": code}\n545\t\n546\t        # 新浪返回的是JS格式，需要解析\n547\t        text = resp.text.strip()\n548\t        if not text or text == \"null\":\n549\t            return {\"ok\": False, \"error\": \"Empty response\", \"code\": code}\n550\t\n551\t        # 解析JSON\n552\t        import json as json_mod\n553\t        data = json_mod.loads(text)\n554\t        if not data:\n555\t            return {\"ok\": False, \"error\": \"No data\", \"code\": code}\n556\t\n557\t        # 转换格式\n558\t        klines = []\n559\t        for row in data:\n560\t            klines.append({\n561\t                \"time\": row.get(\"day\", \"\"),\n562\t                \"open\": float(row.get(\"open\", 0)),\n563\t                \"high\": float(row.get(\"high\", 0)),\n564\t                \"low\": float(row.get(\"low\", 0)),\n565\t                \"close\": float(row.get(\"close\", 0)),\n566\t                \"volume\": int(row.get(\"volume\", 0)),\n567\t            })\n568\t\n569\t        result = {\n570\t            \"ok\": True,\n571\t            \"code\": code,\n572\t            \"scale\": scale,\n573\t            \"klines\": klines,\n574\t            \"count\": len(klines),\n575\t        }\n576\t        _cache_set(cache_key, result)\n577\t        return result\n578\t\n579\t    except Exception as e:\n580\t        return {\"ok\": False, \"error\": f\"{type(e).__name__}: {str(e)[:100]}\", \"code\": code}\n581\t\n582\t\n583\t# =========================================================\n584\t# 4. 大盘指数\n585\t# =========================================================\n586\tdef get_index_daily(symbol: str = \"sh000300\") -> dict:\n587\t    \"\"\"指数日K(沪深300=sh000300, 创业板=sz399006, 上证=sh000001)。\n588\t\n589\t    返回 {ok, latest{close,pct,...}, ma20, error}\n590\t    \"\"\"\n591\t    cache_key = f\"idx_{symbol}\"\n592\t    cached = _cache_get(cache_key, 3600)\n593\t    if cached is not None:\n594\t        return cached\n595\t\n596\t    ak = _ak()\n597\t    if _cb_is_open(\"stock_zh_index_daily\"):\n598\t        return {\"ok\": False, \"error\": \"circuit_open: stock_zh_index_daily\", \"symbol\": symbol}\n599\t    ok, df, err = _safe_call(\"stock_zh_index_daily\", lambda: ak.stock_zh_index_daily(symbol=symbol))\n600\t    _cb_record_success(\"stock_zh_index_daily\") if ok else _cb_record_failure(\"stock_zh_index_daily\")\n601\t    if not ok or df is None or df.empty:\n602\t        return {\"ok\": False, \"error\": err, \"symbol\": symbol}\n603\t\n604\t    df = df.sort_values(\"date\").reset_index(drop=True)\n605\t    closes = df[\"close\"].astype(float).tolist()\n606\t    ma20 = round(sum(closes[-20:]) / 20, 2) if len(closes) >= 20 else None\n607\t    latest = df.iloc[-1]\n608\t    prev = df.iloc[-2] if len(df) >= 2 else None\n609\t    pct = round((latest[\"close\"] - prev[\"close\"]) / prev[\"close\"] * 100, 2) if prev is not None else None\n610\t\n611\t    result = {\n612\t        \"ok\": True,\n613\t        \"symbol\": symbol,\n614\t        \"latest_date\": str(latest[\"date\"]),\n615\t        \"latest_close\": _f(latest[\"close\"]),\n616\t        \"pct\": pct,\n617\t        \"ma20\": ma20,\n618\t        \"above_ma20\": bool(latest[\"close\"] > ma20) if ma20 else None,\n619\t    }\n620\t    _cache_set(cache_key, result)\n621\t    return result\n622\t\n623\t\n624\tdef get_index_realtime() -> dict:\n625\t    \"\"\"主要指数实时涨跌（从全市场行情缓存提取，或用指数日K兜底）。\n626\t\n627\t    由于指数实时接口被封，这里用日K最新收盘 + 全市场行情里的大盘字段推算。\n628\t    \"\"\"\n629\t    # 沪深300/创业板/上证 日K\n630\t    hs300 = get_index_daily(\"sh000300\")\n631\t    cyb = get_index_daily(\"sz399006\")\n632\t    sh = get_index_daily(\"sh000001\")\n633\t    return {\n634\t        \"hs300\": hs300,\n635\t        \"cyb\": cyb,\n636\t        \"sh\": sh,\n637\t    }\n638\t\n639\t\n640\t# =========================================================\n641\t# 5. 行业板块（新浪）\n642\t# =========================================================\n643\tdef get_sector_board() -> dict:\n644\t    \"\"\"新浪行业板块涨跌排名。返回 {ok, sectors[{name,pct,amount,...}], error}。\n645\t\n646\t    用于：(a)个股相对强弱 vs 所属板块 (b)板块联动判断\n647\t    \"\"\"\n648\t    cached = _cache_get(\"sector_board\", 300)\n649\t    if cached is not None:\n650\t        return cached\n651\t\n652\t    ak = _ak()\n653\t    if _cb_is_open(\"stock_sector_spot\"):\n654\t        return {\"ok\": False, \"error\": \"circuit_open: stock_sector_spot\", \"sectors\": []}\n655\t    ok, df, err = _safe_call(\"stock_sector_spot\", lambda: ak.stock_sector_spot(indicator=\"新浪行业\"))\n656\t    _cb_record_success(\"stock_sector_spot\") if ok else _cb_record_failure(\"stock_sector_spot\")\n657\t    if not ok or df is None or df.empty:\n658\t        return {\"ok\": False, \"error\": err, \"sectors\": []}\n659\t\n660\t    sectors = []\n661\t    for _, row in df.iterrows():\n662\t        sectors.append({\n663\t            \"name\": str(row.get(\"板块\", \"\")),\n664\t            \"pct\": _f(row.get(\"涨跌幅\")),\n665\t            \"amount\": _f(row.get(\"总成交额\")),\n666\t            \"count\": _f(row.get(\"公司家数\")),\n667\t            \"top_stock_pct\": _f(row.get(\"个股-涨跌幅\")),\n668\t        })\n669\t    sectors.sort(key=lambda x: x[\"pct\"] if x[\"pct\"] is not None else -999, reverse=True)\n670\t    result = {\"ok\": True, \"sectors\": sectors, \"ts\": datetime.now().isoformat(timespec=\"seconds\")}\n671\t    _cache_set(\"sector_board\", result)\n672\t    return result\n673\t\n674\t\n675\tdef find_sector_of(code: str, pool_meta: dict | None = None) -> str | None:\n676\t    \"\"\"查找个股所属板块。优先用持仓池里手工标注的 sector，否则无法自动获取(接口被封)。\"\"\"\n677\t    if pool_meta and pool_meta.get(\"sector\"):\n678\t        return pool_meta[\"sector\"]\n679\t    return None\n680\t\n681\t\n682\t# 新浪行业板块别名映射：把配置里的常用 sector 名 → 新浪板块表里的实际名\n683\t# 新浪板块表是固定49个，名称较粗（如\"电子器件\"），需要把细分行业归并\n684\t# 新浪49个板块完整列表：玻璃行业/化纤行业/电子器件/次新股/化工行业/陶瓷行业/发电设备/\n685\t# 家具行业/塑料制品/飞机制造/船舶制造/机械行业/电子信息/仪器仪表/家电行业/有色金属/\n686\t# 公路桥梁/交通运输/电力行业/其它行业/供水供气/建筑建材/水泥行业/摩托车/电器行业/\n687\t# 金融行业/开发区/房地产/汽车制造/商业百货/纺织行业/食品行业/煤炭行业/钢铁行业/\n688\t# 服装鞋类/生物制药/酿酒行业/环保行业/物资外贸/医疗器械/印刷包装/综合行业/传媒娱乐/\n689\t# 农药化肥/农林牧渔/石油行业/造纸行业/酒店旅游/纺织机械\n690\tSECTOR_ALIASES = {\n691\t    # ===== 电子/半导体相关 → 电子器件 =====\n692\t    \"通信设备\": \"电子器件\", \"光模块\": \"电子器件\", \"CPO\": \"电子器件\", \"算力\": \"电子器件\",\n693\t    \"半导体\": \"电子器件\", \"芯片\": \"电子器件\", \"集成电路\": \"电子器件\", \"PCB\": \"电子器件\",\n694\t    \"印制电路板\": \"电子器件\", \"电子器件\": \"电子器件\", \"消费电子\": \"电子器件\", \"存储\": \"电子器件\",\n695\t\n696\t    # ===== 软件/数字相关 → 电子信息 =====\n697\t    \"软件\": \"电子信息\", \"信创\": \"电子信息\", \"计算机\": \"电子信息\", \"人工智能\": \"电子信息\",\n698\t    \"AI\": \"电子信息\", \"数据要素\": \"电子信息\", \"数字经济\": \"电子信息\", \"云计算\": \"电子信息\",\n699\t    \"电子信息\": \"电子信息\", \"大数据\": \"电子信息\", \"网络安全\": \"电子信息\",\n700\t\n701\t    # ===== 医药相关 → 生物制药/医疗器械 =====\n702\t    \"创新药\": \"生物制药\", \"CXO\": \"生物制药\", \"医药\": \"生物制药\", \"生物制药\": \"生物制药\",\n703\t    \"医疗器械\": \"医疗器械\", \"医疗\": \"医疗器械\", \"基因\": \"生物制药\",\n704\t\n705\t    # ===== 机械/机器人/低空经济 → 机械行业/飞机制造 =====\n706\t    \"机械\": \"机械行业\", \"机器人\": \"机械行业\", \"减速器\": \"机械行业\", \"工程机械\": \"机械行业\",\n707\t    \"机械行业\": \"机械行业\", \"机床\": \"机械行业\",\n708\t    # 低空经济/eVTOL → 飞机制造（新浪有专门板块）\n709\t    \"低空经济\": \"飞机制造\", \"eVTOL\": \"飞机制造\", \"无人机\": \"飞机制造\", \"飞行汽车\": \"飞机制造\",\n710\t    \"航空\": \"飞机制造\", \"飞机制造\": \"飞机制造\",\n711\t\n712\t    # ===== 船舶/交通 → 船舶制造/交通运输/公路桥梁 =====\n713\t    \"船舶\": \"船舶制造\", \"造船\": \"船舶制造\", \"航运\": \"交通运输\", \"物流\": \"交通运输\",\n714\t    \"交通运输\": \"交通运输\", \"高速公路\": \"公路桥梁\", \"公路桥梁\": \"公路桥梁\",\n715\t\n716\t    # ===== 汽车/新能源车 → 汽车制造/电器行业 =====\n717\t    \"汽车\": \"汽车制造\", \"新能源车\": \"汽车制造\", \"汽车零部件\": \"汽车制造\", \"整车\": \"汽车制造\",\n718\t    \"汽车制造\": \"汽车制造\",\n719\t    # 锂电池/光伏/风电/储能 → 电器行业（发电设备更准确）\n720\t    \"锂电池\": \"电器行业\", \"光伏\": \"发电设备\", \"风电\": \"发电设备\", \"储能\": \"电器行业\",\n721\t    \"电器行业\": \"电器行业\", \"电机\": \"电器行业\",\n722\t\n723\t    # ===== 食品/白酒/消费 → 酿酒/食品/家电/百货 =====\n724\t    \"白酒\": \"酿酒行业\", \"食品饮料\": \"食品行业\", \"酿酒\": \"酿酒行业\", \"食品\": \"食品行业\",\n725\t    \"酿酒行业\": \"酿酒行业\", \"食品行业\": \"食品行业\",\n726\t    \"家电\": \"家电行业\", \"家电行业\": \"家电行业\", \"白色家电\": \"家电行业\",\n727\t    \"旅游\": \"酒店旅游\", \"酒店\": \"酒店旅游\", \"免税\": \"酒店旅游\", \"酒店旅游\": \"酒店旅游\",\n728\t    \"百货\": \"商业百货\", \"零售\": \"商业百货\", \"商业百货\": \"商业百货\",\n729\t    \"服装\": \"服装鞋类\", \"纺织\": \"纺织行业\", \"服装鞋类\": \"服装鞋类\",\n730\t\n731\t    # ===== 金融 → 金融行业（新浪统称，含银行/保险/券商）=====\n732\t    \"银行\": \"金融行业\", \"券商\": \"金融行业\", \"保险\": \"金融行业\", \"金融\": \"金融行业\",\n733\t    \"金融行业\": \"金融行业\", \"信托\": \"金融行业\",\n734\t\n735\t    # ===== 房地产/建筑 =====\n736\t    \"房地产\": \"房地产\", \"地产\": \"房地产\", \"房企\": \"房地产\",\n737\t    \"建筑\": \"建筑建材\", \"建材\": \"建筑建材\", \"建筑建材\": \"建筑建材\",\n738\t    \"水泥\": \"水泥行业\", \"水泥行业\": \"水泥行业\",\n739\t    \"环保\": \"环保行业\", \"环保行业\": \"环保行业\",\n740\t\n741\t    # ===== 周期资源品 → 煤炭/有色/钢铁/化工/石油 =====\n742\t    \"煤炭\": \"煤炭行业\", \"煤炭行业\": \"煤炭行业\",\n743\t    \"有色\": \"有色金属\", \"有色金属\": \"有色金属\", \"铜\": \"有色金属\", \"铝\": \"有色金属\", \"锂\": \"有色金属\",\n744\t    \"钢铁\": \"钢铁行业\", \"钢铁行业\": \"钢铁行业\",\n745\t    \"化工\": \"化工行业\", \"化学\": \"化工行业\", \"化工行业\": \"化工行业\", \"化纤\": \"化纤行业\",\n746\t    \"石油\": \"石油行业\", \"石油行业\": \"石油行业\", \"油气\": \"石油行业\",\n747\t\n748\t    # ===== 农业 → 农林牧渔/农药化肥 =====\n749\t    \"农业\": \"农林牧渔\", \"种业\": \"农药化肥\", \"养殖\": \"农林牧渔\", \"农林牧渔\": \"农林牧渔\",\n750\t    \"农药化肥\": \"农药化肥\", \"化肥\": \"农药化肥\",\n751\t\n752\t    # ===== 电力/公用事业 → 电力行业/供水供气 =====\n753\t    \"电力\": \"电力行业\", \"电力行业\": \"电力行业\", \"火电\": \"电力行业\", \"水电\": \"电力行业\",\n754\t    \"核电\": \"电力行业\", \"绿电\": \"电力行业\",\n755\t    \"供水供气\": \"供水供气\", \"燃气\": \"供水供气\", \"水务\": \"供水供气\",\n756\t\n757\t    # ===== 传媒/教育 =====\n758\t    \"传媒\": \"传媒娱乐\", \"影视\": \"传媒娱乐\", \"游戏\": \"传媒娱乐\", \"教育\": \"传媒娱乐\",\n759\t    \"传媒娱乐\": \"传媒娱乐\",\n760\t\n761\t    # ===== 其他 =====\n762\t    \"摩托车\": \"摩托车\", \"家具\": \"家具行业\", \"玻璃\": \"玻璃行业\", \"陶瓷\": \"陶瓷行业\",\n763\t    \"塑料\": \"塑料制品\", \"印刷\": \"印刷包装\", \"造纸\": \"造纸行业\",\n764\t}\n765\t\n766\t\n767\tdef match_sector_in_board(config_sector: str, board_sectors: list[dict]) -> dict | None:\n768\t    \"\"\"把配置的 sector 名匹配到新浪板块表里的实际板块。\n769\t\n770\t    匹配优先级：1)别名精确映射 2)名称包含 3)返回None\n771\t    返回匹配到的板块 dict（含 name/pct/rank），未匹配返回 None。\n772\t    \"\"\"\n773\t    if not config_sector or not board_sectors:\n774\t        return None\n775\t\n776\t    # 1) 别名映射\n777\t    mapped = SECTOR_ALIASES.get(config_sector, config_sector)\n778\t\n779\t    names = [s.get(\"name\", \"\") for s in board_sectors]\n780\t\n781\t    # 2) 精确匹配映射后的名字\n782\t    for s in board_sectors:\n783\t        if s.get(\"name\") == mapped:\n784\t            return s\n785\t\n786\t    # 3) 模糊包含匹配（任一方向）\n787\t    for s in board_sectors:\n788\t        n = s.get(\"name\", \"\")\n789\t        if n and (mapped in n or n in mapped):\n790\t            return s\n791\t\n792\t    # 4) 关键词分词匹配（把config_sector拆词去板块名里找）\n793\t    for kw in [config_sector[:2], config_sector[-2:]]:\n794\t        for s in board_sectors:\n795\t            n = s.get(\"name\", \"\")\n796\t            if n and kw in n:\n797\t                return s\n798\t\n799\t    return None\n800\t\n801\t\n802\t# =========================================================\n803\t# 6. 美股 + 美债 + 汇率（AkShare 主通道，yfinance 仅可选增强）\n804\t# =========================================================\n805\tdef _expected_us_trading_date() -> date:\n806\t    \"\"\"计算当前北京时间下，最近一个已收盘的美股交易日。\n807\t\n808\t    核心逻辑：将北京时间转为美东时间，判断美股当天是否已收盘(16:00 EDT)。\n809\t    已收盘 → 预期日期 = 当天(美东)；未收盘 → 预期日期 = 前一交易日。\n810\t    跳过周末，不处理美国节假日(节假日数据仍会由 fallback 兜底)。\n811\t    \"\"\"\n812\t    beijing_now = datetime.now()\n813\t    # 北京时间 UTC+8 → 美东 UTC-4 (EDT, 3月第二个周日~11月第一个周日)\n814\t    utc_now = beijing_now - timedelta(hours=8)\n815\t    # 简化处理：4~11月用EDT(UTC-4)，其余用EST(UTC-5)\n816\t    us_east_offset = 4 if 3 <= beijing_now.month <= 10 else 5\n817\t    us_east_now = utc_now + timedelta(hours=12 - us_east_offset)\n818\t\n819\t    us_date = us_east_now.date()\n820\t    us_hour = us_east_now.hour\n821\t\n822\t    if us_hour >= 16:\n823\t        # 美股已收盘，最新完整交易日是今天(美东)\n824\t        expected = us_date\n825\t    else:\n826\t        # 美股尚未收盘(或还没开盘)，最新完整交易日是前一交易日\n827\t        expected = us_date - timedelta(days=1)\n828\t\n829\t    # 跳过周末\n830\t    while expected.weekday() >= 5:  # 5=Sat, 6=Sun\n831\t        expected -= timedelta(days=1)\n832\t\n833\t    return expected\n834\t\n835\t\n836\tdef _fetch_us_stock_tencent(symbol: str) -> Optional[dict]:\n837\t    \"\"\"腾讯财经 fallback：获取美股最新行情+前收盘价，计算涨跌幅。\n838\t\n839\t    使用 web.ifzq.gtimg.cn/appstock/app/fqkline 接口(与美债 fallback 同源)。\n840\t    qt 字段格式: [name, code, current_price, prev_close, open, volume, ..., date]\n841\t    返回 {close, pct, date} 或 None(失败时)。\n842\t    \"\"\"\n843\t    import requests as _req\n844\t    url = (\n845\t        f\"https://web.ifzq.gtimg.cn/appstock/app/fqkline/get\"\n846\t        f\"?param=us{symbol},day,,,3,\"\n847\t    )\n848\t    try:\n849\t        resp = _req.get(url, timeout=8, headers={\n850\t            \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\n851\t        })\n852\t        if resp.status_code != 200:\n853\t            return None\n854\t        data = resp.json()\n855\t        inner = data.get(\"data\", {}).get(f\"us{symbol}\", {})\n856\t\n857\t        # 优先从 qt 字段提取：qt 包含精确的 current_price 和 prev_close\n858\t        qt = inner.get(\"qt\", {})\n859\t        qt_data = qt.get(f\"us{symbol}\", [])\n860\t        if qt_data and len(qt_data) >= 5:\n861\t            # qt 格式: ['real', 'name', 'ticker', current_price, prev_close, open, ...]\n862\t            try:\n863\t                current = float(qt_data[3])\n864\t                prev_close = float(qt_data[4])\n865\t                if current > 0 and prev_close > 0:\n866\t                    pct = round((current - prev_close) / prev_close * 100, 2)\n867\t                    # 从 day 字段获取日期\n868\t                    day_data = inner.get(\"day\") or inner.get(\"qfqday\") or []\n869\t                    date_str = day_data[-1][0] if day_data else str(date.today())\n870\t                    return {\"close\": current, \"pct\": pct, \"date\": date_str}\n871\t            except (ValueError, IndexError):\n872\t                pass\n873\t\n874\t        # qt 不可用时，从 day 字段计算(需要足够多的连续交易日数据)\n875\t        days = inner.get(\"qfqday\") or inner.get(\"day\") or []\n876\t        if len(days) >= 2:\n877\t            # 确保最后两条是连续交易日(排除腾讯返回\"首日+末日\"的情况)\n878\t            try:\n879\t                d1 = datetime.strptime(days[-1][0], \"%Y-%m-%d\").date()\n880\t                d2 = datetime.strptime(days[-2][0], \"%Y-%m-%d\").date()\n881\t                if (d1 - d2).days <= 4:  # 连续交易日(含周末)\n882\t                    latest = days[-1]\n883\t                    prev = days[-2]\n884\t                    close = float(latest[2])\n885\t                    prev_close = float(prev[2])\n886\t                    pct = round((close - prev_close) / prev_close * 100, 2) if prev_close else None\n887\t                    return {\"close\": close, \"pct\": pct, \"date\": latest[0]}\n888\t            except (ValueError, IndexError):\n889\t                pass\n890\t\n891\t        return None\n892\t    except Exception:\n893\t        return None\n894\t\n895\t\n896\tdef get_us_market(symbols: list[str] | None = None) -> dict:\n897\t    \"\"\"隔夜美股日K。默认拉 NVDA/AMD/TSLA。\n898\t\n899\t    v0.86 修复：\n900\t    1. 日期校验：检查 AkShare 返回数据的日期是否为最近已收盘的美股交易日\n901\t    2. 自动 Fallback：数据过期(>2天偏差)时自动切换腾讯财经 API\n902\t    3. 新鲜度标注：返回结果增加 is_stale 字段，供下游判断数据可靠性\n903\t    4. 预期日期计算：基于北京时间→美东时间转换，判断美股是否已收盘\n904\t\n905\t    返回 {symbol: {close, pct, date, is_stale, source?}, ...}\n906\t    \"\"\"\n907\t    if symbols is None:\n908\t        symbols = [\"NVDA\", \"AMD\", \"TSLA\"]\n909\t\n910\t    expected_date = _expected_us_trading_date()\n911\t    out = {}\n912\t    ak = _ak()\n913\t\n914\t    for sym in symbols:\n915\t        cache_key = f\"us_{sym}\"\n916\t        cached = _cache_get(cache_key, 3600)\n917\t        if cached is not None:\n918\t            out[sym] = cached\n919\t            continue\n920\t\n921\t        if _cb_is_open(\"stock_us_daily\"):\n922\t            # AkShare 熔断时直接用腾讯 fallback\n923\t            tx = _fetch_us_stock_tencent(sym)\n924\t            if tx:\n925\t                tx[\"is_stale\"] = False\n926\t                tx[\"source\"] = \"tencent_fallback\"\n927\t                out[sym] = tx\n928\t                _cache_set(cache_key, tx)\n929\t            else:\n930\t                out[sym] = {\"ok\": False, \"error\": \"circuit_open: stock_us_daily + tencent_failed\"}\n931\t            continue\n932\t\n933\t        ok, df, err = _safe_call(\n934\t            \"stock_us_daily\",\n935\t            lambda s=sym: ak.stock_us_daily(symbol=s, adjust=\"qfq\")\n936\t        )\n937\t        _cb_record_success(\"stock_us_daily\") if ok else _cb_record_failure(\"stock_us_daily\")\n938\t\n939\t        if ok and df is not None and not df.empty:\n940\t            df = df.sort_values(\"date\")\n941\t            latest = df.iloc[-1]\n942\t            prev = df.iloc[-2] if len(df) >= 2 else None\n943\t\n944\t            # === v0.86 新增：数据新鲜度校验 ===\n945\t            try:\n946\t                data_date = pd.Timestamp(str(latest[\"date\"])).date() if hasattr(pd, 'Timestamp') else \\\n947\t                    datetime.strptime(str(latest[\"date\"])[:10], \"%Y-%m-%d\").date()\n948\t            except Exception:\n949\t                try:\n950\t                    data_date = datetime.strptime(str(latest[\"date\"])[:10], \"%Y-%m-%d\").date()\n951\t                except Exception:\n952\t                    data_date = expected_date  # 无法解析则假设新鲜\n953\t\n954\t            # 预期日期 = 最近已收盘的美股交易日(见 _expected_us_trading_date)。\n955\t            # days_stale=0 → 数据日期 = 预期日期，完全新鲜\n956\t            # days_stale=1 → 数据是前一交易日的，属于 T+1 延迟(今天最常见的场景)\n957\t            # days_stale≥2 → 明显过期，AkShare 后端可能故障\n958\t            # 策略：days_stale ≥ 1 即触发 fallback，因为我们的 _expected_us_trading_date\n959\t            # 已经将\"未收盘\"的情况回退到了前一交易日，所以 days_stale=1 意味着数据确实落后了。\n960\t            days_stale = (expected_date - data_date).days\n961\t            is_stale = days_stale >= 1\n962\t\n963\t            if is_stale:\n964\t                print(f\"[STALE] {sym}: 数据日期={data_date}, 预期={expected_date}, \"\n965\t                      f\"偏差{days_stale}天 → 尝试腾讯财经 fallback\")\n966\t                tx = _fetch_us_stock_tencent(sym)\n967\t                if tx:\n968\t                    print(f\"[FRESH] {sym}: 腾讯 fallback 成功 → {tx['date']}\")\n969\t                    tx[\"is_stale\"] = False\n970\t                    tx[\"source\"] = \"tencent_fallback\"\n971\t                    out[sym] = tx\n972\t                    _cache_set(cache_key, tx)\n973\t                    continue\n974\t                else:\n975\t                    print(f\"[WARN] {sym}: 腾讯 fallback 也失败，返回 stale 数据\")\n976\t                    # Fallback 失败：返回 stale 数据但明确标注\n977\t                    pct = round(\n978\t                        (latest[\"close\"] - prev[\"close\"]) / prev[\"close\"] * 100, 2\n979\t                    ) if prev is not None else None\n980\t                    rec = {\n981\t                        \"close\": _f(latest[\"close\"]),\n982\t                        \"pct\": pct,\n983\t                        \"date\": str(latest[\"date\"]),\n984\t                        \"is_stale\": True,\n985\t                        \"stale_days\": days_stale,\n986\t                        \"expected_date\": str(expected_date),\n987\t                        \"warning\": f\"AkShare数据过期{days_stale}天且腾讯fallback失败，请WebSearch验证\",\n988\t                        \"source\": \"akshare_stale\",\n989\t                    }\n990\t                    out[sym] = rec\n991\t                    _cache_set(cache_key, rec)  # 缓存但缩短有效时间(已在cache中)\n992\t                    continue\n993\t\n994\t            # === 数据新鲜，正常返回 ===\n995\t            pct = round(\n996\t                (latest[\"close\"] - prev[\"close\"]) / prev[\"close\"] * 100, 2\n997\t            ) if prev is not None else None\n998\t            rec = {\n999\t                \"close\": _f(latest[\"close\"]),\n1000\t                \"pct\": pct,\n1001\t                \"date\": str(latest[\"date\"]),\n1002\t                \"is_stale\": False,\n1003\t            }\n1004\t            out[sym] = rec\n1005\t            _cache_set(cache_key, rec)\n1006\t        else:\n1007\t            # AkShare 调用失败：尝试腾讯 fallback\n1008\t            tx = _fetch_us_stock_tencent(sym)\n1009\t            if tx:\n1010\t                print(f\"[FALLBACK] {sym}: AkShare失败，腾讯fallback成功\")\n1011\t                tx[\"is_stale\"] = False\n1012\t                tx[\"source\"] = \"tencent_fallback\"\n1013\t                out[sym] = tx\n1014\t                _cache_set(cache_key, tx)\n1015\t            else:\n1016\t                out[sym] = {\"ok\": False, \"error\": err}\n1017\t\n1018\t    return {\"ok\": True, \"data\": out}\n1019\t\n1020\t\n1021\tdef last_valid_row(df, key_cols=None):\n1022\t    \"\"\"v0.88 防护：取最后一个关键字段非NaN的行，跳过\"当天未结算完\"的半成品NaN行。\n1023\t\n1024\t    用于修复美债/汇率/商品等延迟更新日线 iloc[-1] 取到整行NaN 的问题\n1025\t    (如 bond_zh_us_rate 最新一行常是当天日期但美债列尚未结算，全为NaN)。\n1026\t    - key_cols: str 或 list[str]，要求这些列非NaN；None 时退化为最后一个非全NaN行。\n1027\t    返回 pandas Series(一行)；df 为空返回 None。\n1028\t    \"\"\"\n1029\t    if df is None or len(df) == 0:\n1030\t        return None\n1031\t    if key_cols:\n1032\t        cols = [c for c in (key_cols if isinstance(key_cols, (list, tuple)) else [key_cols]) if c in df.columns]\n1033\t        if cols:\n1034\t            valid = df.dropna(subset=cols)\n1035\t            if len(valid) > 0:\n1036\t                return valid.iloc[-1]\n1037\t    valid_any = df.dropna(how=\"all\")\n1038\t    return valid_any.iloc[-1] if len(valid_any) > 0 else df.iloc[-1]\n1039\t\n1040\t\n1041\tdef get_us_treasury() -> dict:\n1042\t    \"\"\"中美国债收益率。返回最新一行的美债10Y/30Y/2Y。\"\"\"\n1043\t    cached = _cache_get(\"us_treasury\", 3600)\n1044\t    if cached is not None:\n1045\t        return cached\n1046\t    ak = _ak()\n1047\t    if _cb_is_open(\"bond_zh_us_rate\"):\n1048\t        return {\"ok\": False, \"error\": \"circuit_open: bond_zh_us_rate\"}\n1049\t    ok, df, err = _safe_call(\"bond_zh_us_rate\", lambda: ak.bond_zh_us_rate(start_date=(datetime.now() - timedelta(days=30)).strftime(\"%Y%m%d\")))\n1050\t    _cb_record_success(\"bond_zh_us_rate\") if ok else _cb_record_failure(\"bond_zh_us_rate\")\n1051\t    if not ok or df is None or df.empty:\n1052\t        return {\"ok\": False, \"error\": err}\n1053\t    df = df.sort_values(\"日期\")\n1054\t    last = last_valid_row(df, \"美国国债收益率30年\")  # v0.88: 跳过当天未结算完的NaN半成品行(美债熔断关键)\n1055\t    rec = {\n1056\t        \"ok\": True,\n1057\t        \"date\": str(last[\"日期\"]),\n1058\t        \"us_10y\": _f(last.get(\"美国国债收益率10年\")),\n1059\t        \"us_30y\": _f(last.get(\"美国国债收益率30年\")),\n1060\t        \"us_2y\": _f(last.get(\"美国国债收益率2年\")),\n1061\t        \"cn_10y\": _f(last.get(\"中国国债收益率10年\")),\n1062\t        \"yield_breakout_5pct\": _f(last.get(\"美国国债收益率10年\"), 0) >= 5.0,  # STRATEGY_DEPOSIT 策略B触发\n1063\t    }\n1064\t    _cache_set(\"us_treasury\", rec)\n1065\t    return rec\n1066\t\n1067\t\n1068\tdef get_usd_cny() -> dict:\n1069\t    \"\"\"央行汇率(USD/CNY)。返回最新中间价/中行折算价。\"\"\"\n1070\t    cached = _cache_get(\"usd_cny\", 3600)\n1071\t    if cached is not None:\n1072\t        return cached\n1073\t    ak = _ak()\n1074\t    end = datetime.now().strftime(\"%Y%m%d\")\n1075\t    start = (datetime.now() - timedelta(days=10)).strftime(\"%Y%m%d\")\n1076\t    if _cb_is_open(\"currency_boc_sina\"):\n1077\t        return {\"ok\": False, \"error\": \"circuit_open: currency_boc_sina\"}\n1078\t    ok, df, err = _safe_call(\"currency_boc_sina\", lambda: ak.currency_boc_sina(symbol=\"美元\", start_date=start, end_date=end))\n1079\t    _cb_record_success(\"currency_boc_sina\") if ok else _cb_record_failure(\"currency_boc_sina\")\n1080\t    if not ok or df is None or df.empty:\n1081\t        return {\"ok\": False, \"error\": err}\n1082\t    df = df.sort_values(\"日期\")\n1083\t    last = last_valid_row(df, \"中行折算价\")  # v0.88: 跳过当天未结算完的NaN行\n1084\t    rec = {\n1085\t        \"ok\": True,\n1086\t        \"date\": str(last[\"日期\"]),\n1087\t        \"mid_price\": _f(last.get(\"央行中间价\")),\n1088\t        \"boc_rate\": _f(last.get(\"中行折算价\")),\n1089\t        \"buy\": _f(last.get(\"中行汇买价\")),\n1090\t        \"sell\": _f(last.get(\"中行钞卖价/汇卖价\")),\n1091\t    }\n1092\t    _cache_set(\"usd_cny\", rec)\n1093\t    return rec\n1094\t\n1095\t\n1096\t# =========================================================\n1097\t# 7. 交易日历\n1098\t# =========================================================\n1099\tdef get_trade_calendar() -> dict:\n1100\t    \"\"\"交易日历。返回 {ok, dates:set, is_trading_today, next_trade_date}\"\"\"\n1101\t    cached = _cache_get(\"trade_cal\", 86400)  # 缓存1天\n1102\t    if cached is not None:\n1103\t        return cached\n1104\t    ak = _ak()\n1105\t    ok, df, err = _safe_call(\"tool_trade_date_hist_sina\", ak.tool_trade_date_hist_sina)\n1106\t    if not ok or df is None or df.empty:\n1107\t        return {\"ok\": False, \"error\": err}\n1108\t    dates = set()\n1109\t    for d in df[\"trade_date\"].tolist():\n1110\t        dates.add(str(d).replace(\"-\", \"\")[:8])\n1111\t    today = datetime.now().strftime(\"%Y%m%d\")\n1112\t    is_today = today in dates\n1113\t    nxt = None\n1114\t    for i in range(1, 15):\n1115\t        cand = (datetime.now() + timedelta(days=i)).strftime(\"%Y%m%d\")\n1116\t        if cand in dates:\n1117\t            nxt = cand\n1118\t            break\n1119\t    rec = {\"ok\": True, \"count\": len(dates), \"is_trading_today\": is_today, \"next_trade_date\": nxt, \"dates_sample\": sorted(dates)[-10:]}\n1120\t    _cache_set(\"trade_cal\", rec)\n1121\t    return rec\n1122\t\n1123\t\n1124\t# =========================================================\n1125\t# 趋势股判断（解决均线回归偏见）\n1126\t# =========================================================\n1127\tdef is_trend_stock(closes: list, highs: list, vols: list) -> dict:\n1128\t    \"\"\"\n1129\t    判断是否为趋势股（解决均线回归偏见）\n1130\t    \n1131\t    问题背景：\n1132\t    - 原有逻辑用\"等回调到MA20\"策略，在趋势市中导致踏空\n1133\t    - 趋势股沿着MA5上涨，不会回到MA20\n1134\t    - 例如：兆易创新一周涨40%，但MA20只涨11%，系统一直建议等回调，导致完全踏空\n1135\t    \n1136\t    解决方案：\n1137\t    - 震荡股：用\"回调买入\"（等回调到MA20）\n1138\t    - 趋势股：用\"突破买入\"（突破MA5且放量→买入）\n1139\t    \n1140\t    趋势股判断标准：\n1141\t    1. 连续3天收盘在MA5之上\n1142\t    2. 最近3天有2天创新高\n1143\t    3. 量比(LR)>1.2\n1144\t    \n1145\t    Args:\n1146\t        closes: 收盘价列表（至少5天）\n1147\t        highs: 最高价列表（至少5天）\n1148\t        vols: 成交量列表（至少20天）\n1149\t    \n1150\t    Returns:\n1151\t        {\n1152\t            \"is_trend\": bool,  # 是否为趋势股\n1153\t            \"strategy\": str,   # 推荐策略：\"趋势跟踪\" / \"均值回归\"\n1154\t            \"buy_signal\": str, # 买入信号描述\n1155\t            \"stop_loss_ref\": str, # 止损参考：\"MA5\" / \"MA20\"\n1156\t            \"reasons\": list    # 判断理由\n1157\t        }\n1158\t    \"\"\"\n1159\t    if len(closes) < 5 or len(highs) < 5 or len(vols) < 20:\n1160\t        return {\n1161\t            \"is_trend\": False,\n1162\t            \"strategy\": \"均值回归\",\n1163\t            \"buy_signal\": \"数据不足，默认用均值回归\",\n1164\t            \"stop_loss_ref\": \"MA20\",\n1165\t            \"reasons\": [\"数据不足\"]\n1166\t        }\n1167\t    \n1168\t    ma5 = sum(closes[-5:]) / 5\n1169\t    reasons = []\n1170\t    \n1171\t    # 条件1：连续3天收盘在MA5之上\n1172\t    above_ma5_count = sum(1 for c in closes[-3:] if c > ma5)\n1173\t    above_ma5 = above_ma5_count == 3\n1174\t    reasons.append(f\"连续3天在MA5之上: {above_ma5_count}/3 {'✅' if above_ma5 else '❌'}\")\n1175\t    \n1176\t    # 条件2：最近3天有2天创新高\n1177\t    new_highs_count = sum(1 for i in range(-3, 0) if highs[i] > highs[i-1])\n1178\t    new_highs = new_highs_count >= 2\n1179\t    reasons.append(f\"最近3天创新高: {new_highs_count}/3 {'✅' if new_highs else '❌'}\")\n1180\t    \n1181\t    # 条件3：量比>1.2\n1182\t    vol_ma20 = sum(vols[-20:]) / 20\n1183\t    lr = vols[-1] / vol_ma20 if vol_ma20 > 0 else 0\n1184\t    lr_ok = lr > 1.2\n1185\t    reasons.append(f\"量比LR={lr:.2f} {'✅' if lr_ok else '❌'}\")\n1186\t    \n1187\t    is_trend = above_ma5 and new_highs and lr_ok\n1188\t    \n1189\t    if is_trend:\n1190\t        return {\n1191\t            \"is_trend\": True,\n1192\t            \"strategy\": \"趋势跟踪\",\n1193\t            \"buy_signal\": f\"突破MA5({ma5:.2f})且放量→买入（不等回调）\",\n1194\t            \"stop_loss_ref\": \"MA5\",\n1195\t            \"reasons\": reasons\n1196\t        }\n1197\t    else:\n1198\t        ma20 = sum(closes[-20:]) / 20 if len(closes) >= 20 else closes[-1]\n1199\t        return {\n1200\t            \"is_trend\": False,\n1201\t            \"strategy\": \"均值回归\",\n1202\t            \"buy_signal\": f\"等回调到MA20({ma20:.2f})\",\n1203\t            \"stop_loss_ref\": \"MA20\",\n1204\t            \"reasons\": reasons\n1205\t        }\n1206\t\n1207\t\n1208\t# =========================================================\n1209\t# 辅助函数\n1210\t# =========================================================\n1211\tdef _clean_code(code: str) -> str:\n1212\t    \"\"\"清理代码：去掉 sz/sh 前缀，只留6位数字。\"\"\"\n1213\t    return \"\".join(c for c in str(code) if c.isdigit())\n1214\t\n1215\t\n1216\tdef _f(val, default=None) -> Optional[float]:\n1217\t    \"\"\"安全转 float。NaN/None/异常返回 default。\"\"\"\n1218\t    if val is None:\n1219\t        return default\n1220\t    try:\n1221\t        f = float(val)\n1222\t        if f != f:  # NaN\n1223\t            return default\n1224\t        return round(f, 4) if abs(f) < 1e9 else f\n1225\t    except (ValueError, TypeError):\n1226\t        return default\n1227\t\n1228\t\n1229\t# =========================================================\n1230\t# 自测\n1231\t# =========================================================\n1232\tif __name__ == \"__main__\":\n1233\t    print(\"=\" * 60)\n1234\t    print(\"data_layer 自测\")\n1235\t    print(\"=\" * 60)\n1236\t\n1237\t    print(\"\\n[1] 个股日K + 均线 (300502)\")\n1238\t    h = get_stock_hist(\"300502\", 120)\n1239\t    if h.get(\"ok\"):\n1240\t        print(f\"  最新日期={h['latest_date']} 收盘={h['latest']['close']} 涨跌={h['latest']['pct']}%\")\n1241\t        print(f\"  MA5={h['ma5']} MA10={h['ma10']} MA20={h['ma20']} MA60={h['ma60']}\")\n1242\t        print(f\"  量能LR={h['lr']} 近20日高={h['recent_high20']} 低={h['recent_low20']}\")\n1243\t    else:\n1244\t        print(f\"  ERR: {h.get('error')}\")\n1245\t\n1246\t    print(\"\\n[2] 大盘指数 沪深300/创业板\")\n1247\t    for sym, name in [(\"sh000300\", \"沪深300\"), (\"sz399006\", \"创业板\")]:\n1248\t        idx = get_index_daily(sym)\n1249\t        if idx.get(\"ok\"):\n1250\t            print(f\"  {name}: 收盘={idx['latest_close']} 涨跌={idx['pct']}% MA20={idx['ma20']} 站上MA20={idx['above_ma20']}\")\n1251\t        else:\n1252\t            print(f\"  {name} ERR: {idx.get('error')}\")\n1253\t\n1254\t    print(\"\\n[3] 行业板块涨跌(前5/后5)\")\n1255\t    sb = get_sector_board()\n1256\t    if sb.get(\"ok\"):\n1257\t        ss = sb[\"sectors\"]\n1258\t        for s in ss[:5]:\n1259\t            print(f\"  ↑ {s['name']} {s['pct']}%\")\n1260\t        print(\"  ...\")\n1261\t        for s in ss[-5:]:\n1262\t            print(f\"  ↓ {s['name']} {s['pct']}%\")\n1263\t\n1264\t    print(\"\\n[4] 隔夜美股 NVDA/AMD/TSLA\")\n1265\t    us = get_us_market()\n1266\t    for sym, d in us.get(\"data\", {}).items():\n1267\t        if d.get(\"close\"):\n1268\t            print(f\"  {sym}: 收盘={d['close']} 涨跌={d.get('pct')}% 日期={d.get('date')}\")\n1269\t\n1270\t    print(\"\\n[5] 美债10Y/30Y + USD/CNY\")\n1271\t    tr = get_us_treasury()\n1272\t    if tr.get(\"ok\"):\n1273\t        print(f\"  美10Y={tr['us_10y']}% 美30Y={tr['us_30y']}% 突破5%生死线={tr['yield_breakout_5pct']}\")\n1274\t    fx = get_usd_cny()\n1275\t    if fx.get(\"ok\"):\n1276\t        print(f\"  USD/CNY 中间价={fx['mid_price']} 中行折算={fx.get('boc_rate')}\")\n1277\t\n1278\t    print(\"\\n[6] 交易日历\")\n1279\t    tc = get_trade_calendar()\n1280\t    print(f\"  今日是否交易日={tc.get('is_trading_today')} 下一交易日={tc.get('next_trade_date')}\")\n1281\t\n1282\t    print(\"\\n[7] 单股实时(优先缓存)\")\n1283\t    rt = get_stock_realtime(\"300502\")\n1284\t    print(f\"  300502: {rt.get('name')} 价={rt.get('price')} 涨跌={rt.get('pct')}% 量比={rt.get('volume_ratio')} 源={rt.get('source')}\")\n1285\t\n1286\t    print(\"\\n\" + \"=\" * 60)\n1287\t    print(\"data_layer 自测完成\")\n1288\t"}]},"uuid":"45b52dcd-c381-432b-8b35-36256b45fbf1","timestamp":"2026-08-14T01:22:34.635Z","toolUseResult":{"type":"text","file":{"filePath":"F:\\软件-图书仓库\\skills\\a-stock-quantimental\\scripts\\data_layer.py","content":"
