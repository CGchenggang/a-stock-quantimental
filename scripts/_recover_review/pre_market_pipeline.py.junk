# -*- coding: utf-8 -*-\n2\t\"\"\"9:15 盘前自动报告流水线 (pre_market_pipeline.py)\n3\t\n4\t核心交付。每日 08:30 定时跑，09:00 前生成完整盘前预案并推送飞书。\n5\t\n6\t6段合成：\n7\t① 隔夜美股(NVDA/AMD/TSLA)  ② 先行指标(美债/汇率)  ③ 昨日盘后(大盘/板块)\n8\t④ 今日事件(交易日历/财报检查)  ⑤ 持仓体检(调stock_diagoser精简版)  ⑥ 综合结论\n9\t\n10\t用法：\n11\t    python pre_market_pipeline.py            # 生成报告+保存\n12\t    python pre_market_pipeline.py --push     # 生成+推送飞书\n13\t    python pre_market_pipeline.py --push --no-save  # 只推送不存盘\n14\t\"\"\"\n15\tfrom __future__ import annotations\n16\t\n17\timport argparse\n18\timport json\n19\timport sys\n20\timport warnings\n21\tfrom datetime import datetime, timedelta\n22\tfrom pathlib import Path\n23\t\n24\twarnings.filterwarnings(\"ignore\")\n25\t\n26\t# ---- UTF-8 防御（防御层3：脚本内显式修复 stdout 编码）----\n27\t# 根因：英文 Windows locale=cp1252，print 中文时 UnicodeEncodeError。\n28\t# sitecustomize.py 提供全局根治，这里作为脚本级兜底，确保任何启动方式都不崩。\n29\tfor _s in (sys.stdout, sys.stderr):\n30\t    try:\n31\t        _s.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n32\t    except Exception:\n33\t        pass\n34\t\n35\tSCRIPT_DIR = Path(__file__).resolve().parent\n36\tSKILL_DIR = SCRIPT_DIR.parent\n37\tDATABASE_DIR = SKILL_DIR / \"database\"\n38\t\n39\tif str(SCRIPT_DIR) not in sys.path:\n40\t    sys.path.insert(0, str(SCRIPT_DIR))"}]},"uuid":"0f42ab01-7c1d-45e1-adfc-1ee366537442","timestamp":"2026-08-17T00:38:18.393Z","toolUseResult":{"type":"text","file":{"filePath":"F:\\软件-图书仓库\\skills\\a-stock-quantimental\\scripts\\pre_market_pipeline.py","content":"
