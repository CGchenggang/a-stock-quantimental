ck_zh_a_spot_em\"\n185-        else:\n186-            ok2, df2, err2 = _safe_call(\"stock_zh_a_spot_em\", ak.stock_zh_a_spot_em)\n187-            _cb_record_success(\"stock_zh_a_spot_em\") if ok2 else _cb_record_failure(\"stock_zh_a_spot_em\")\n188-        if not ok2 or df2 is None or df2.empty:\n189-            return {\"ok\": False, \"error\": f\"sina:{err} | em:{err2}\", \"quotes\": {}}\n190-        df = df2\n191-\n192-    quotes = {}\n193-    for _, row in df.iterrows():\n194-        raw_code = str(row.get(\"代码\", \"\")).strip()\n195-        if not raw_code:\n196-            continue\n197-        # 新浪返回带前缀(sz300502)，同时存纯数字键(300502)方便按数字代码查询\n198-        digits = _clean_code(raw_code)\n199-        entry = {\n200-            \"code\": digits,\n201-            \"raw_code\": raw_code,\n202-            \"name\": str(row.get(\"名称\", \"\")),\n203-            \"price\": _f(row.get(\"最新价\")),\n204-            \"pct\": _f(row.get(\"涨跌幅\")),\n205-            \"change\": _f(row.get(\"涨跌额\")),\n206-            \"prev_close\": _f(row.get(\"昨收\")),\n207-            \"open\": _f(row.get(\"今开\")),\n208-            \"high\": _f(row.get(\"最高\")),\n209-            \"low\": _f(row.get(\"最低\")),\n210-            \"volume\": _f(row.get(\"成交量\")),\n211-            \"amount\": _f(row.get(\"成交额\")),\n212-            \"turnover\": _f(row.get(\"换手率\")),\n213-            \"volume_ratio\": _f(row.get(\"量比\")),  # 量比\n214-        }\n215-        quotes[digits] = entry  # 主键用纯数字\n216-        quotes[raw_code] = entry  # 兼容带前缀查询\n217-    result = {\"ok\": True, \"error\": \"\", \"count\": len(quotes), \"quotes\": quotes, \"ts\": datetime.now().isoformat(timespec=\"seconds\")}\n218-    _cache_set(\"realtime_all\", result)\n219-    return result\n220-\n221-\n222-def get_stock_realtime(code: str) -> dict:\n223-    \"\"\"单股实时行情。三级兜底：\n224-    1) 新浪全市场缓存(秒级,盘中最准) → 2) 分时接口 → 3) 日K收盘价(盘后/兜底)\n225-\n226-    特殊处理：新浪全市场在非交易时段(9:00前/15:30后)实时价返回0，\n227-    此时自动用昨收价兜底并标注 source，避免下游显示0元误判。\n228-    \"\"\"\n229-    code = _clean_code(code)\n230-    # 1) 全市场缓存\n231-    all_q = get_realtime_quotes()\n232-    if all_q.get(\"ok\") and code in all_q[\"quotes\"]:\n233-        q = dict(all_q[\"quotes\"][code])\n234-        q[\"ok\"] = True\n235-        # 检测实时价为0(非交易时段新浪返回0)，用昨收兜底\n236-        if not q.get(\"price\") or q.get(\"price\") == 0:\n237-            prev = q.get(\"prev_close\")\n238-            if prev and prev > 0:\n239-                q[\"price\"] = prev\n240-                # 盘前/盘后兜底：用上一个交易日的实际涨跌幅（而非0.0）\n241-                # 避免诊断时所有股票pct=0与指数比较后全部显示\"显著弱于大盘\"\n242-                fallback_pct = 0.0\n243-                try:\n--\n290:def get_stock_hist(code: str, days: int = 120) -> dict:\n291-    \"\"\"个股日K，并计算 MA5/10/20/60、量能比LR。\n292-\n293-    主通道：新浪 stock_zh_a_daily（需 sz/sh 前缀，英文列名，稳定）。\n294-    备用：东方财富 stock_zh_a_hist（中文列名，常被限流）。\n295-\n296-    返回 {ok, code, latest_date, latest{}, ma5/ma10/ma20/ma60, vol_ma20, lr,\n297-          recent_high20, recent_low20, closes_tail, kline_count, error}\n298-    \"\"\"\n299-    code = _clean_code(code)\n300-    cache_key = f\"hist_{code}_{days}\"\n301-    cached = _cache_get(cache_key, 3600)  # 日K缓存1小时\n302-    if cached is not None:\n303-        return cached\n304-\n305-    ak = _ak()\n306-    # 加 sz/sh 前缀（新浪要求）：6开头沪市，其余深市\n307-    sina_symbol = (\"sh\" if code.startswith(\"6\") else \"sz\") + code\n308-\n309-    df = None\n310-    err = \"\"\n311-    # 熔断检查：新浪日K\n312-    sina_open = _cb_is_open(\"stock_zh_a_daily\")\n313-    # 主通道：新浪日K（英文列名 date/open/high/low/close/volume/amount）\n314-    for attempt in range(3):\n315-        if sina_open:\n316-            err = \"circuit_open: stock_zh_a_daily\"\n317-            break\n318-        ok, d, err = _safe_call(\"stock_zh_a_daily\", lambda: ak.stock_zh_a_daily(symbol=sina_symbol, adjust=\"qfq\"))\n319-        if ok and d is not None and not d.empty:\n320-            _cb_record_success(\"stock_zh_a_daily\")\n321-            df = d\n322-            break\n323-        _cb_record_failure(\"stock_zh_a_daily\")\n324-        time.sleep(1.5)\n325-\n326-    # 备用：东方财富（中文列名 日期/开盘/收盘...）——常被限流，仅兜底\n327-    if df is None:\n328-        if _cb_is_open(\"stock_zh_a_hist\"):\n329-            err2 = \"circuit_open: stock_zh_a_hist\"\n330-        else:\n331-            ok2, df2, err2 = _safe_call(\"stock_zh_a_hist\", lambda: ak.stock_zh_a_hist(symbol=code, period=\"daily\", adjust=\"qfq\"))\n332-            _cb_record_success(\"stock_zh_a_hist\") if (ok2 and df2 is not None and not df2.empty) else _cb_record_failure(\"stock_zh_a_hist\")\n333-            if ok2 and df2 is not None and not df2.empty:\n334-                df = df2\n335-\n336-    if df is None or df.empty:\n337-        return {\"ok\": False, \"error\": f\"sina:{err} | em:fallback_failed\", \"code\": code}\n338-\n339-    # 统一列名（兼容新浪英文 / 东方财富中文）\n340-    colmap = {\"date\": \"date\", \"日期\": \"date\", \"open\": \"open\", \"开盘\": \"open\",\n341-              \"close\": \"close\", \"收盘\": \"close\", \"high\": \"high\", \"最高\": \"high\",\n342-              \"low\": \"low\", \"最低\": \"low\", \"volume\": \"volume\", \"成交量\": \"volume\",\n343-              \"amount\": \"amount\", \"成交额\": \"amount\"}\n344-    df = df.rename(columns={k: v for k, v in colmap.items() if k in df.columns})\n345-    df = df.sort_values(\"date\").reset_index(drop=True)\n346-\n347-    # 【当日数据修正】检查最后一条日期是否是今天，如果不是则用实时行情覆盖\n348-    today_str = datetime.now().strftime(\"%Y-%m-%d\")\n349-    last_date = str(df.iloc[-1][\"date\"])[:10]  # 取前10字符（YYYY-MM-DD）\n350-    \n351-    if last_date != today_str:\n352-        # 日K数据不是今天，尝试从实时行情获取今日收盘数据\n353-        realtime = get_realtime_quotes()\n354-        if realtime.get(\"ok\") and code in realtime[\"quotes\"]:\n355-            q = realtime[\"quotes\"][code]\n356-            if q.get(\"price\") and q[\"price\"] > 0:  # 有有效价格\n357-                # 追加今日数据\n358-                import pandas as pd\n359-                today_row = pd.DataFrame([{\n360-                    \"date\": today_str,\n361-                    \"open\": q.get(\"open\") or q[\"price\"],\n362-                    \"high\": q.get(\"high\") or q[\"price\"],\n363-                    \"low\": q.get(\"low\") or q[\"price\"],\n364-                    \"close\": q[\"price\"],\n365-                    \"volume\": q.get(\"volume\") or 0,\n366-                }])\n367-                df = pd.concat([df, today_row], ignore_index=True)\n368-\n369-    closes = df[\"close\"].astype(float).tolist()\n370-    highs = df[\"high\"].astype(float).tolist()\n--\n1211:def _clean_code(code: str) -> str:\n1212-    \"\"\"清理代码：去掉 sz/sh 前缀，只留6位数字。\"\"\"\n1213-    return \"\".join(c for c in str(code) if c.isdigit())\n1214-\n1215-\n1216-def _f(val, default=None) -> Optional[float]:\n1217-    \"\"\"安全转 float。NaN/None/异常返回 default。\"\"\"\n1218-    if val is None:\n1219-        return default\n1220-    try:\n1221-        f = float(val)\n1222-        if f != f:  # NaN\n1223-            return default\n1224-        return round(f, 4) if abs(f) < 1e9 else f\n1225-    except (ValueError, TypeError):\n1226-        return default\n1227-\n1228-\n1229-# =========================================================\n1230-# 自测\n1231-# =========================================================\n1232-if __name__ == \"__main__\":\n1233-    print(\"=\" * 60)\n1234-    print(\"data_layer 自测\")\n1235-    print(\"=\" * 60)\n1236-\n1237-    print(\"\\n[1] 个股日K + 均线 (300502)\")\n1238-    h = get_stock_hist(\"300502\", 120)\n1239-    if h.get(\"ok\"):\n1240-        print(f\"  最新日期={h['latest_date']} 收盘={h['latest']['close']} 涨跌={h['latest']['pct']}%\")\n1241-        print(f\"  MA5={h['ma5']} MA10={h['ma10']} MA20={h['ma20']} MA60={h['ma60']}\")\n1242-        print(f\"  量能LR={h['lr']} 近20日高={h['recent_high20']} 低={h['recent_low20']}\")\n1243-    else:\n1244-        print(f\"  ERR: {h.get('error')}\")\n1245-\n1246-    print(\"\\n[2] 大盘指数 沪深300/创业板\")\n1247-    for sym, name in [(\"sh000300\", \"沪深300\"), (\"sz399006\", \"创业板\")]:\n1248-        idx = get_index_daily(sym)\n1249-        if idx.get(\"ok\"):\n1250-            print(f\"  {name}: 收盘={idx['latest_close']} 涨跌={idx['pct']}% MA20={idx['ma20']} 站上MA20={idx['above_ma20']}\")\n1251-        else:\n1252-            print(f\"  {name} ERR: {idx.get('error')}\")\n1253-\n1254-    print(\"\\n[3] 行业板块涨跌(前5/后5)\")\n1255-    sb = get_sector_board()\n1256-    if sb.get(\"ok\"):\n1257-        ss = sb[\"sectors\"]\n1258-        for s in ss[:5]:\n1259-            print(f\"  ↑ {s['name']} {s['pct']}%\")\n1260-        print(\"  ...\")\n1261-        for s in ss[-5:]:\n1262-            print(f\"  ↓ {s['name']} {s['pct']}%\")\n1263-\n1264-    print(\"\\n[4] 隔夜美股 NVDA/AMD/TSLA\")\n1265-    us = get_us_market()\n1266-    for sym, d in us.get(\"data\", {}).items():\n1267-        if d.get(\"close\"):\n1268-            print(f\"  {sym}: 收盘={d['close']} 涨跌={d.get('pct')}% 日期={d.get('date')}\")\n1269-\n1270-    print(\"\\n[5] 美债10Y/30Y + USD/CNY\")\n1271-    tr = get_us_treasury()\n1272-    if tr.get(\"ok\"):\n1273-        print(f\"  美10Y={tr['us_10y']}% 美30Y={tr['us_30y']}% 突破5%生死线={tr['yield_breakout_5pct']}\")\n1274-    fx = get_usd_cny()\n1275-    if fx.get(\"ok\"):\n1276-        print(f\"  USD/CNY 中间价={fx['mid_price']} 中行折算={fx.get('boc_rate')}\")\n1277-\n1278-    print(\"\\n[6] 交易日历\")\n1279-    tc = get_trade_calendar()\n1280-    print(f\"  今日是否交易日={tc.get('is_trading_today')} 下一交易日={tc.get('next_trade_date')}\")\n1281-\n1282-    print(\"\\n[7] 单股实时(优先缓存)\")\n1283-    rt = get_stock_realtime(\"300502\")\n1284-    print(f\"  300502: {rt.get('name')} 价={rt.get('price')} 涨跌={rt.get('pct')}% 量比={rt.get('volume_ratio')} 源={rt.get('source')}\")\n1285-\n1286-    print(\"\\n\" + \"=\" * 60)\n1287-    print(\"data_layer 自测完成\")","numLines":241,"totalLines":241},"sourceToolAssistantUUID":"ddefe61e-4f14-4c8c-a862-c1cc1549cf25","session_id":"df33713e-6c00-4d1f-af2a-9d28a323194c","userType":"external","entrypoint":"cli","cwd":"E:\\playgroud","sessionId":"df33713e-6c00-4d1f-af2