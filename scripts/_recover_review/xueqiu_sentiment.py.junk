# -*- coding: utf-8 -*-\n\"\"\"Markdown 渲染器 (md_renderer.py)\n\n把诊断结果 / 盘前报告的结构化 dict 渲染成可读 markdown 文本。\n集中一处，避免散落在各脚本里。所有数值做空值保护，None 显示为 '-'。\n\n被 stock_diagoser.py 和 pre_market_pipeline.py 调用。\n\"\"\"\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Any\n\n\ndef _v(val, suffix: str = \"\", fmt: str = \"\") -> str:\n    \"\"\"空值保护 + 格式化。None/异常 → '-'。\"\"\"\n    if val is None or val == \"\":\n        return \"-\"\n    try:\n        f = float(val)\n        if f != f:  # NaN\n            return \"-\"\n        if fmt:\n            return (fmt % f) + suffix\n        return str(val) + suffix\n    except (ValueError, TypeError):\n        return str(val) + suffix\n\n\ndef _pct(val) -> str:\n    \"\"\"百分比带颜色符号（纯文本环境用箭头）。\"\"\"\n    if val is None or val == \"\":\n        return \"-\"\n    try:\n        f = float(val)\n        if f != f:\n            return \"-\"\n        arrow = \"↑\" if f > 0 else (\"↓\" if f < 0 else \"→\")\n        return f\"{arrow}{abs(f):.2f}%\"\n    except (ValueError, TypeError):\n        return \"-\"\n\n\ndef _bar(score: int, total: int = 10) -> str:\n    \"\"\"分数条：8/10 → ████████░░\"\"\"\n    if score is None:\n        return \"-\"\n    filled = max(0, min(total, int(score)))\n    return \"█\" * filled + \"░\" * (total - filled) + f\" {score}/{total}\"\n\n\n# =========================================================\n# 1. 单股诊断报告\n# =========================================================\ndef render_diagnosis(result: dict) -> str:\n    \"\"\"渲染个股8维诊断报告。result 结构见 stock_diagoser.diagnose()。\n\n    返回 markdown 字符串。\n    \"\"\"\n    if not result.get(\"ok\"):\n        return f\"## ❌ 诊断失败：{result.get('code','-')}\\n\\n{result.get('error','未知错误')}\"\n\n    code = result.get(\"code\", \"-\")\n    name = result.get(\"name\", \"\")\n    title = f\"## 📊 {name}({code}) 个股诊断\"\n\n    lines = [title, \"\"]\n    lines.append(f\"> 诊断时间：{result.get('diag_time','-')} ｜ 数据源：{result.get('data_source','-')}\")\n    lines.append(\"\")\n\n    # ---- 价格快照 ----\n    snap = result.get(\"snapshot\", {})\n    lines.append(\"### 📈 价格快照\")\n    lines.append(f\"- 最新价 **{_v(snap.get('price'),'元')}** ｜ 今日 {_pct(snap.get('pct'))}\")\n    lines.append(f\"- 今开 {_v(snap.get('open'),'元')} / 最高 {_v(snap.get('high'),'元')} / 最低 {_v(snap.get('low'),'元')} / 昨收 {_v(snap.get('prev_close'),'元')}\")\n    if snap.get(\"turnover\") is not None:\n        lines.append(f\"- 换手率 {_v(snap.get('turnover'),'%','%.2f')} ｜ 量比 {_v(snap.get('volume_ratio'))}\")\n    # 非交易时段/兜底数据源提示\n    src = snap.get(\"source\", \"\")\n    if src in (\"prev_close_fallback\", \"daily_close_fallback\", \"sina_spot_zero\"):\n        lines.append(f\"- ⚠️ **{_v(snap.get('_note'),'',)}**（实时价待9:30开盘后更新）\")\n    lines.append(\"\")\n\n    # ---- ① 趋势定性 ----\n    t = result.get(\"trend\", {})\n    lines.append(\"### ① 趋势定性\")\n    lines.append(f\"- **判定：{t.get('verdict','-')}**\")\n    ma = t.get(\"ma\", {})\n    lines.append(f\"- MA5={_v(ma.get('ma5'))} ｜ MA10={_v(ma.get('ma10'))} ｜ MA20={_v(ma.get('ma20'))} ｜ MA60={_v(ma.get('ma60'))}\")\n    if t.get(\"detail\"):\n        lines.append(f\"- {t['detail']}\")\n    lines.append(\"\")\n\n    # ---- ② 分时形态 ----\n    intr = result.get(\"intraday\", {})\n    lines.append(\"### ② 分时形态\")\n    if intr.get(\"available\"):\n        lines.append(f\"- **判定：{intr.get('verdict','-')}**\")\n        lines.append(f\"- 分时均线(VWAP)={_v(intr.get('vwap'),'元')} ｜ 现价={_v(intr.get('last_price'),'元')}\")\n        if intr.get(\"detail\"):","numLines":100,"startLine":1,"totalLines":467}},"sourceToolAssistantUUID":"e1254dcb-14db-4bdb-9438-8b72cab06bcb","session_id":"df33713e-6c00-4d1f-af2a-9d28a323194c","userType":"external","entrypoint":"cli","cwd":"E:\\playgroud","sessionId":"df33713e-6c00-4d1f-af2a-9d28a323194c","version":"2.1.229","gitBranch":"HEAD","slug":"concurrent-brewing-kay"}
