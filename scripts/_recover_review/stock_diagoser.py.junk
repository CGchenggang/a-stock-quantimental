# -*- coding: utf-8 -*-\n2\t\"\"\"盘中个股8维快速诊断 (stock_diagoser.py)\n3\t\n4\t核心交付。输入股票代码，10秒内输出趋势/分时/量价/资金/相对强弱/技术位/板块联动/操作建议。\n5\t\n6\t双模式：\n7\t- 按需查询：python stock_diagoser.py 300502\n8\t- 自动巡航：python stock_diagoser.py --pool   (诊断 auto_target_pool.json 全部)\n9\t- 推送飞书：python stock_diagoser.py 300502 --push\n10\t\n11\t每个维度独立函数，失败降级跳过（记录到 data_gaps），绝不中断主流程。\n12\t\"\"\"\n13\tfrom __future__ import annotations\n14\t\n15\timport argparse\n16\timport json\n17\timport sys\n18\timport warnings\n19\tfrom datetime import datetime\n20\tfrom pathlib import Path\n21\t\n22\twarnings.filterwarnings(\"ignore\")\n23\t\n24\t# ── 修复 Git Bash / Windows 控制台 cp1252 编码问题 ─\n25\t# 当 stdout 非 UTF-8 时（如 Git Bash 默认 cp1252），强制包装为 UTF-8\n26\t# 这样 argparse help / print 中的中文字符就不会 UnicodeEncodeError\n27\tif hasattr(sys.stdout, 'buffer') and sys.stdout.encoding and sys.stdout.encoding.lower() != 'utf-8':\n28\t    import io as _io\n29\t    sys.stdout = _io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')\n30\tif hasattr(sys.stderr, 'buffer') and sys.stderr.encoding and sys.stderr.encoding.lower() != 'utf-8':\n31\t    import io as _io\n32\t    sys.stderr = _io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')\n33\t\n34\tSCRIPT_DIR = Path(__file__).resolve().parent\n35\tSKILL_DIR = SCRIPT_DIR.parent\n36\tDATABASE_DIR = SKILL_DIR / \"database\"\n37\t\n38\t# 加入路径以便导入同目录模块\n39\tif str(SCRIPT_DIR) not in sys.path:\n40\t    sys.path.insert(0, str(SCRIPT_DIR))\n41\t# 加入 skill 根目录以便导入 feishu_pusher\n42\tif str(SKILL_DIR) not in sys.path:\n43\t    sys.path.insert(0, str(SKILL_DIR))\n44\t\n45\timport data_layer as dl  # noqa: E402\n46\timport md_renderer  # noqa: E402\n47\timport trading_discipline  # noqa: E402\n48\t\n49\t\n50\t# =========================================================\n51\t# 8 维诊断函数\n52\t# =========================================================\n53\t\n54\tdef calc_bias_rate(price, hist) -> dict:\n55\t    \"\"\"⑧.⑥ 乖离率监控（v0.90新增）。\n56\t\n57\t    计算价格 vs MA5/10/20/60 的乖离率，判断是否过热或超卖。\n58\t    乖离率 = (现价 - MA) / MA * 100%\n59\t\n60\t    判定阈值（分层）：\n61\t    - MA5/MA10 短期乖离 > 15%: 警觉\n62\t    - MA20 中期乖离 > 25%: 强制降仓\n63\t    - MA60 长期乖离 > 40%: 极端信号\n64\t    - 乖离 < -10%: 超卖关注\n65\t    - 乖离 < -20%: 极端超卖\n66\t    \"\"\"\n67\t    if not hist.get(\"ok\"):\n68\t        return {\"ok\": False, \"biases\": {}, \"max_bias\": 0, \"risk\": \"UNKNOWN\", \"action\": \"数据不可用\"}\n69\t\n70\t    ma5 = hist.get(\"ma5\")\n71\t    ma10 = hist.get(\"ma10\")\n72\t    ma20 = hist.get(\"ma20\")\n73\t    ma60 = hist.get(\"ma60\")\n74\t    p = price if price else hist[\"latest\"][\"close\"]\n75\t\n76\t    biases = {}\n77\t    for name, ma_val in [(\"ma5\", ma5), (\"ma10\", ma10), (\"ma20\", ma20), (\"ma60\", ma60)]:\n78\t        if ma_val and ma_val > 0:\n79\t            biases[name] = round((p - ma_val) / ma_val * 100, 2)\n80\t\n81\t    if not biases:\n82\t        return {\"ok\": False, \"biases\": {}, \"max_bias\": 0, \"risk\": \"UNKNOWN\", \"action\": \"均线数据不可用\"}\n83\t\n84\t    max_bias = max(biases.values())\n85\t    min_bias = min(biases.values())\n86\t\n87\t    # 分层判定：短期(MA5/MA10) 和 中长期(MA20/MA60) 分别评估\n88\t    short_bias = max(biases.get(\"ma5\", 0), biases.get(\"ma10\", 0))\n89\t    mid_bias = biases.get(\"ma20\", 0)\n90\t    long_bias = biases.get(\"ma60\", 0)\n91\t\n92\t    if max_bias > 40 or long_bias > 40:\n93\t        risk = \"EXTREME_OVERHEAT\"\n94\t        action = \"禁止开新仓，建议减仓至30%以下\"\n95\t    elif mid_bias > 25 or short_bias > 30:\n96\t        risk = \"OVERHEAT\"\n97\t        action = \"仓位上限-10%，止损收紧1%，禁止加仓\"\n98\t    elif short_bias > 15:\n99\t        risk = \"WARM\"\n100\t        action = \"趋势偏热，关注回调风险，不追高\"\n101\t    elif min_bias < -20:\n102\t        risk = \"EXTREME_OVERSOLD\"\n103\t        action = \"极端超卖，关注左侧机会，可分批试探\"\n104\t    elif min_bias < -10:\n105\t        risk = \"OVERSOLD\"\n106\t        action = \"超卖区间，关注反弹信号\"\n107\t    else:\n108\t        risk = \"NORMAL\"\n109\t        action = \"乖离率正常\"\n110\t\n111\t    return {\n112\t        \"ok\": True,\n113\t        \"biases\": biases,\n114\t        \"max_bias\": max_bias,\n115\t        \"min_bias\": min_bias,\n116\t        \"short_bias\": short_bias,\n117\t        \"mid_bias\": mid_bias,\n118\t        \"long_bias\": long_bias,\n119\t        \"risk\": risk,\n120\t        \"action\": action,\n121\t    }\n122\t\n123\t\n124\tdef classify_pullback_vs_breakdown(hist, current_price, lr=None) -> dict:\n125\t    \"\"\"⑧.⑦ 回踩vs破位判定器（v0.90新增）。\n126\t\n127\t    核心问题：多头排列中的下跌不一定是回踩，可能是破位。\n128\t    7/2兆易创新跳空跌停时均线仍呈多头排列（滞后），\n129\t    但这是破位不是回踩。\n130\t\n131\t    判定维度（评分制，>=4分为破位）：\n132\t    1. 回撤幅度：从近期高点回撤>5% +1，>10% +2\n133\t    2. 成交量方向：放量(LR>1.2) +1，缩量(LR<0.8) -1\n134\t    3. 连续阴线数：>=3根 +1\n135\t    4. MA5斜率：拐头向下 +1\n136\t    5. 跌停：直接 +5（极端事件，一票否决）\n137\t    \"\"\"\n138\t    if not hist.get(\"ok\"):\n139\t        return {\"ok\": False, \"classification\": \"UNKNOWN\", \"confidence\": 0, \"score\": 0, \"reason\": \"数据不可用\", \"action\": \"无法判定\"}\n140\t\n141\t    # 从hist获取近5日K线数据\n142\t    daily = hist.get(\"daily_list\", [])\n143\t    if len(daily) < 5:\n144\t        closes_tail = hist.get(\"closes_tail\", [])\n145\t        if len(closes_tail) < 3:\n146\t            return {\"ok\": False, \"classification\": \"UNKNOWN\", \"confidence\": 0, \"score\": 0, \"reason\": \"K线数据不足\", \"action\": \"无法判定\"}\n147\t        daily = [{\"close\": c, \"open\": c, \"high\": c, \"low\": c, \"volume\": 0} for c in closes_tail]\n148\t\n149\t    recent = daily[-5:] if len(daily) >= 5 else daily\n150\t\n151\t    # 维度1: 回撤幅度\n152\t    recent_high = max(d.get(\"high\", d.get(\"close\", 0)) for d in recent)\n153\t    drawdown = (current_price - recent_high) / recent_high * 100 if recent_high > 0 else 0\n154\t\n155\t    # 维度2: 成交量方向\n156\t    vols = [d.get(\"volume\", 0) for d in recent]\n157\t    vol_today = vols[-1] if vols else 0\n158\t    vol_avg = sum(vols[:-1]) / max(len(vols) - 1, 1) if len(vols) > 1 else 0\n159\t    vol_ratio = vol_today / vol_avg if vol_avg > 0 else 1\n160\t    if lr is not None and lr > 0:\n161\t        vol_ratio = max(vol_ratio, lr)\n162\t\n163\t    # 维度3: 连续阴线数\n164\t    bearish_count = sum(1 for d in recent if d.get(\"close\", 0) < d.get(\"open\", 0))\n165\t\n166\t    # 维度4: MA5斜率\n167\t    closes = [d.get(\"close\", 0) for d in recent]\n168\t    if len(closes) >= 5:\n169\t        ma5_today = sum(closes[-5:]) / 5\n170\t        ma5_3ago = sum(closes[-5:-3]) / 2\n171\t        ma5_slope_down = ma5_today < ma5_3ago\n172\t    else:\n173\t        ma5_slope_down = False\n174\t\n175\t    # 维度5: 是否有跌停（单日跌幅>9.5%）\n176\t    has_limit_down = False\n177\t    for d in recent:\n178\t        c = d.get(\"close\", 0)\n179\t        o = d.get(\"open\", 0)\n180\t        prev_c = d.get(\"pre_close\", o)\n181\t        if prev_c > 0 and (c - prev_c) / prev_c < -0.095:\n182\t            has_limit_down = True\n183\t            break\n184\t    if not has_limit_down:\n185\t        for d in recent:\n186\t            c = d.get(\"close\", 0)\n187\t            o = d.get(\"open\", 0)\n188\t            if o > 0 and (c - o) / o < -0.095:\n189\t                has_limit_down = True\n190\t                break\n191\t\n192\t    # 综合评分\n193\t    breakdown_score = 0\n194\t    reasons = []\n195\t\n196\t    if drawdown < -5:\n197\t        breakdown_score += 1\n198\t        reasons.append(f\"回撤{drawdown:.1f}%\")\n199\t    if drawdown < -10:\n200\t        breakdown_score += 2\n201\t        reasons.append(f\"回撤幅度大({drawdown:.1f}%)\")\n202\t    if vol_ratio > 1.2:\n203\t        breakdown_score += 1\n204\t        reasons.append(f\"放量(量比{vol_ratio:.2f})\")\n205\t    elif vol_ratio < 0.8:\n206\t        breakdown_score -= 1\n207\t        reasons.append(f\"缩量(量比{vol_ratio:.2f})\")\n208\t    if bearish_count >= 3:\n209\t        breakdown_score += 1\n210\t        reasons.append(f\"连阴{bearish_count}天\")\n211\t    if ma5_slope_down:\n212\t        breakdown_score += 1\n213\t        reasons.append(\"MA5拐头向下\")\n214\t    if has_limit_down:\n215\t        breakdown_score += 5\n216\t        reasons.append(\"出现跌停\")\n217\t\n218\t    # 判定\n219\t    if breakdown_score >= 4 or has_limit_down:\n220\t        classification = \"BREAKDOWN\"\n221\t        confidence = min(breakdown_score * 15 + 20, 95)\n222\t        action = \"禁止回踩买入，持仓者考虑减仓\"\n223\t        reason_str = f\"破位信号(评分{breakdown_score})：\" + \"，\".join(reasons)\n224\t    elif breakdown_score <= 1:\n225\t        classification = \"PULLBACK\"\n226\t        confidence = 85 - abs(breakdown_score) * 10\n227\t        action = \"可按回踩策略执行\"\n228\t        reason_str = f\"正常回踩(评分{breakdown_score})：\" + \"，\".join(reasons) if reasons else \"正常回踩\"\n229\t    else:\n230\t        classification = \"NEUTRAL\"\n231\t        confidence = 50\n232\t        action = \"观望，不执行买入\"\n233\t        reason_str = f\"信号混合(评分{breakdown_score})：\" + \"，\".join(reasons) if reasons else \"信号混合\"\n234\t\n235\t    return {\n236\t        \"ok\": True,\n237\t        \"classification\": classification,\n238\t        \"confidence\": confidence,\n239\t        \"score\": breakdown_score,\n240\t        \"drawdown\": round(drawdown, 2),\n241\t        \"vol_ratio\": round(vol_ratio, 2),\n242\t        \"bearish_count\": bearish_count,\n243\t        \"ma5_slope_down\": ma5_slope_down,\n244\t        \"has_limit_down\": has_limit_down,\n245\t        \"reason\": reason_str,\n246\t        \"action\": action,\n247\t    }\n248\t\n249\t\n250\tdef analyze_trend(price, hist) -> dict:\n251\t    \"\"\"① 趋势定性：实时价 vs MA5/10/20/60 多空排列 + 乖离率监控（v0.90增强）。\"\"\"\n252\t    if not hist.get(\"ok\"):\n253\t        return {\"verdict\": \"数据不可用\", \"detail\": \"日K数据获取失败\", \"ma\": {}, \"bias\": {\"ok\": False}}\n254\t\n255\t    ma5, ma10, ma20, ma60 = hist.get(\"ma5\"), hist.get(\"ma10\"), hist.get(\"ma20\"), hist.get(\"ma60\")\n256\t    ma = {\"ma5\": ma5, \"ma10\": ma10, \"ma20\": ma20, \"ma60\": ma60}\n257\t    p = price if price else hist[\"latest\"][\"close\"]\n258\t\n259\t    # 判定多空排列\n260\t    parts = [x for x in [ma5, ma10, ma20, ma60] if x is not None]\n261\t    if len(parts) < 4:\n262\t        return {\"verdict\": \"数据不足\", \"detail\": \"均线数据不全\", \"ma\": ma, \"bias\": {\"ok\": False}}\n263\t\n264\t    # 核心判定：价与MA20/MA60（中期趋势）+ MA5/MA10（短期节奏）\n265\t    above_ma20 = p > ma20\n266\t    above_ma60 = p > ma60\n267\t    ma5_above_ma20 = ma5 > ma20\n268\t    ma5_above_ma10 = ma5 > ma10\n269\t\n270\t    if p > ma5 > ma10 > ma20 > ma60:\n271\t        verdict = \"多头排列(强趋势)\"\n272\t        detail = f\"价{p}>MA5>MA10>MA20>MA60，趋势健康向上\"\n273\t    elif above_ma20 and above_ma60 and ma5_above_ma20 and p > ma5:\n274\t        verdict = \"多头排列(强势)\"\n275\t        detail = f\"价{p}>MA5>MA20>MA60，短中期多头，中期趋势向上\"\n276\t    elif above_ma20 and above_ma60 and p > ma5:\n277\t        verdict = \"多头格局(短期整理)\"\n278\t        detail = f\"价{p}>MA5且在MA20/MA60上方，中期多头，MA5({ma5})略低于MA10({ma10})属短期整理\"\n279\t    elif above_ma20 and above_ma60 and ma5_above_ma20:\n280\t        verdict = \"多头格局(回踩中)\"\n281\t        detail = f\"在MA20/MA60上方但价<MA5，多头格局中的回踩，关注MA20支撑\"\n282\t    elif p < ma5 < ma10 < ma20:\n283\t        verdict = \"空头排列(弱势)\"\n284\t        detail = f\"价{p}<MA5<MA10<MA20，趋势走弱，警惕\"\n285\t    elif not above_ma20 and not above_ma60 and ma5 < ma20 < ma60 and p < ma5:\n286\t        verdict = \"空头排列(强弱势)\"\n287\t        detail = \"长短均线全部空头，坚决回避\"\n288\t    elif ma20 and abs(p - ma20) / ma20 < 0.02:\n289\t        verdict = \"粘合震荡\"\n290\t        detail = f\"价格在MA20({ma20})附近缠绕，方向不明\"\n291\t    else:\n292\t        verdict = \"震荡分化\"\n293\t        detail = f\"均线排列混乱(价{p}/MA5{ma5}/MA10{ma10}/MA20{ma20}/MA60{ma60})，无明确趋势\"\n294\t\n295\t    # MA20 生命线风险提示\n296\t    if ma20 and p < ma20:\n297\t        detail += f\" ｜ ⚠️跌破MA20生命线({ma20})\"\n298\t\n299\t    # v0.90新增：乖离率监控\n300\t    bias = calc_bias_rate(p, hist)\n301\t    if bias.get(\"ok\"):\n302\t        max_bias = bias.get(\"max_bias\", 0)\n303\t        risk = bias.get(\"risk\", \"NORMAL\")\n304\t        if risk == \"EXTREME_OVERHEAT\":\n305\t            detail += f\" ｜ 🔴极端过热(乖离{max_bias:+.1f}%)，禁止开新仓\"\n306\t        elif risk == \"OVERHEAT\":\n307\t            detail += f\" ｜ 🟠过热(乖离{max_bias:+.1f}%)，仓位上限-10%\"\n308\t        elif risk == \"WARM\":\n309\t            detail += f\" ｜ 🟡偏热(乖离{max_bias:+.1f}%)，不追高\"\n310\t        elif risk == \"EXTREME_OVERSOLD\":\n311\t            detail += f\" ｜ 🔵极端超卖(乖离{bias.get('min_bias', 0):.1f}%)，关注左侧机会\"\n312\t        elif risk == \"OVERSOLD\":\n313\t            detail += f\" ｜ 🟢超卖(乖离{bias.get('min_bias', 0):.1f}%)，关注反弹\"\n314\t\n315\t    return {\"verdict\": verdict, \"detail\": detail, \"ma\": ma, \"bias\": bias}\n316\t\n317\t\n318\tdef calc_recovery_rate(hist: dict) -> dict:\n319\t    \"\"\"⑥ 暴跌修复率（第6个健康度指标，v0.85 新增）。\n320\t\n321\t    以近60日最低收盘价为基准，计算当前价格相对该低点的修复程度。\n322\t    衡量\"距历史极端低点的安全边际\"，借鉴claude-stock的锚定创伤方法。\n323\t\n324\t    Args:\n325\t        hist: get_stock_hist() 返回的 dict（需含 closes_tail 字段）\n326\t\n327\t    Returns:\n328\t        {\n329\t            \"recent_low\": float,      # 近60日最低收盘价\n330\t            \"current_price\": float,    # 当前价\n331\t            \"recovery_pct\": float,     # 修复率 = (现价-低点)/低点 * 100%\n332\t            \"verdict\": str,            # 判定结果\n333\t            \"health_score\": int        # 健康+2 / 衰减+1 / 反转0\n334\t        }\n335\t    \"\"\"\n336\t    if not hist.get(\"ok\"):\n337\t        return {\"verdict\": \"数据不可用\", \"health_score\": 0, \"recovery_pct\": None}\n338\t\n339\t    latest = hist.get(\"latest\", {})\n340\t    current = latest.get(\"close\")\n341\t    if not current or current <= 0:\n342\t        return {\"verdict\": \"价格无效\", \"health_score\": 0, \"recovery_pct\": None}\n343\t\n344\t    # 从日K线中取近60日最低收盘价\n345\t    # get_stock_hist 默认取120天数据，closes_tail只有近5天\n346\t    # 需要从完整K线中提取，这里用 recent_low20 做近似（20日低点）\n347\t    # 如果有更多数据可以用 hist 中的 closes 列表\n348\t    recent_low = hist.get(\"recent_low20\")\n349\t    if not recent_low or recent_low <= 0:\n350\t        return {\"verdict\": \"低点数据不足\", \"health_score\": 0, \"recovery_pct\": None}\n351\t\n352\t    recovery_pct = round((current - recent_low) / recent_low * 100, 2)\n353\t\n354\t    if current < recent_low:\n355\t        verdict = \"创新低\"\n356\t        health_score = 0\n357\t    elif recovery_pct < 5:\n358\t        verdict = f\"未修复(+{recovery_pct}%)，贴近低点{recent_low}\"\n359\t        health_score = 0\n360\t    elif recovery_pct < 20:\n361\t        verdict = f\"修复中(+{recovery_pct}%)，低点{recent_low}\"\n362\t        health_score = 1\n363\t    else:\n364\t        verdict = f\"已修复(+{recovery_pct}%)，低点{recent_low}\"\n365\t        health_score = 2\n366\t\n367\t    return {\n368\t        \"recent_low\": recent_low,\n369\t        \"current_price\": current,\n370\t        \"recovery_pct\": recovery_pct,\n371\t        \"verdict\": verdict,\n372\t        \"health_score\": health_score,\n373\t    }\n374\t\n375\t\n376\tdef analyze_intraday(code) -> dict:\n377\t    \"\"\"② 分时形态：是否站稳分时均线(VWAP黄线)。\"\"\"\n378\t    intra = dl.get_intraday(code)\n379\t    if not intra.get(\"ok\"):\n380\t        return {\"available\": False, \"note\": \"盘后/非盘中，分时数据不可用\"}\n381\t\n382\t    vwap = intra.get(\"vwap\")\n383\t    last = intra.get(\"last_price\")\n384\t    if not vwap or not last:\n385\t        return {\"available\": False, \"note\": \"分时数据不完整\"}\n386\t\n387\t    # 计算分时走势方向（用末段 ticks）\n388\t    ticks = intra.get(\"ticks\", [])\n389\t    if len(ticks) >= 10:\n390\t        recent = [t[\"price\"] for t in ticks[-20:] if t.get(\"price\")]\n391\t        early = [t[\"price\"] for t in ticks[:20] if t.get(\"price\")]\n392\t        if recent and early:\n393\t            slope = (sum(recent) / len(recent)) - (sum(early) / len(early))\n394\t\n395\t    if last > vwap:\n396\t        if last > vwap * 1.01:\n397\t            verdict = \"站稳分时线(偏强)\"\n398\t            detail = f\"现价{last}在VWAP{vwap}上方1%+，分时偏强\"\n399\t        else:\n400\t            verdict = \"分时线上方(中性偏强)\"\n401\t            detail = f\"现价{last}略高于VWAP{vwap}\"\n402\t    elif last < vwap:\n403\t        if last < vwap * 0.99:\n404\t            verdict = \"跌破分时线(偏弱)\"\n405\t            detail = f\"现价{last}在VWAP{vwap}下方1%+，分时偏弱，警惕\"\n406\t        else:\n407\t            verdict = \"分时线下方(中性偏弱)\"\n408\t            detail = f\"现价{last}略低于VWAP{vwap}\"\n409\t    else:\n410\t        verdict = \"贴着分时线(平衡)\"\n411\t        detail = f\"现价{last}贴近VWAP{vwap}\"\n412\t\n413\t    return {\n414\t        \"available\": True,\n415\t        \"verdict\": verdict,\n416\t        \"vwap\": vwap,\n417\t        \"last_price\": last,\n418\t        \"detail\": detail,\n419\t    }\n420\t\n421\t\n422\tdef analyze_volume_price(snap, hist) -> dict:\n423\t    \"\"\"③ 量价关系：量比/换手/LR量能火控/量价背离。\"\"\"\n424\t    if not hist.get(\"ok\"):\n425\t        return {\"verdict\": \"数据不可用\", \"detail\": \"日K缺失\"}\n426\t\n427\t    lr = hist.get(\"lr\")  # 量能火控 = 今日量/MA20量\n428\t    turnover = snap.get(\"turnover\") if snap else hist[\"latest\"].get(\"turnover\")\n429\t    pct = snap.get(\"pct\") if snap else hist[\"latest\"].get(\"pct\")\n430\t\n431\t    # LR 体制判定（SKILL.md 模块2量能火控）\n432\t    if lr is None:\n433\t        regime, verdict = \"未知\", \"量能数据不全\"\n434\t    elif lr < 0.6:\n435\t        regime, verdict = \"冰冻期\", \"严重缩量(冰冻)\"\n436\t    elif lr < 0.9:\n437\t        regime, verdict = \"枯水期\", \"缩量(枯水)\"\n438\t    elif lr < 1.1:\n439\t        regime, verdict = \"平水期\", \"量能正常(平水)\"\n440\t    elif lr < 1.5:\n441\t        regime, verdict = \"丰水期\", \"温和放量(丰水)\"\n442\t    else:\n443\t        regime, verdict = \"洪水期\", \"显著放量(洪水)\"\n444\t\n445\t    # 量价背离判断\n446\t    detail = f\"LR={lr}({regime})\" if lr else \"LR未知\"\n447\t    if pct is not None and lr is not None:\n448\t        if pct > 3 and lr < 0.9:\n449\t            detail += \" ｜ ⚠️涨而缩量(顶背离迹象)\"\n450\t        elif pct < -3 and lr > 1.3:\n451\t            detail += \" ｜ ⚠️跌而放量(恐慌/出货行为)\"\n452\t        elif pct > 3 and lr > 1.3:\n453\t            detail += \" ｜ ✅放量上涨(资金进场)\"\n454\t        elif -1 < pct < 1 and lr > 1.5:\n455\t            detail += \" ｜ ⚠️放量滞涨(顶部信号)\"\n456\t\n457\t    if turnover:\n458\t        detail += f\" ｜ 换手{turnover}%\"\n459\t\n460\t    return {\"verdict\": verdict, \"lr\": lr, \"lr_regime\": regime, \"turnover\": turnover, \"detail\": detail}\n461\t\n462\t\n463\tdef check_volume_price_signal(code: str, snap: dict, hist: dict) -> dict:\n464\t    \"\"\"③+ 量价信号硬规则判断（v0.8新增）。\n465\t\n466\t    三层判断：\n467\t    1. 量比+跌幅 → 日线级别大方向（恐慌出货/缩量阴跌/混合）\n468\t    2. 分时成交量 → 盘中精确时机（放量下跌/放量反弹/缩量）\n469\t    3. 综合信号 → 操作建议\n470\t\n471\t    核心规则（必须记住）：\n472\t    - 量比>2 且 跌幅>5% → 恐慌出货 → 清仓\n473\t    - 量比<1.2 且 跌幅<4% → 缩量阴跌 → 持有观察\n474\t    - 其他情况 → 看分时成交量方向\n475\t\n476\t    Returns:\n477\t        {\n478\t            ok: bool,\n479\t            signal: 'PANIC' | 'NORMAL' | 'MIXED',\n480\t            volume_ratio: float,\n481\t            change_pct: float,\n482\t            minute_signal: 'SELLING' | 'BOUNCE' | 'NEUTRAL',\n483\t            action: str,  # 操作建议\n484\t            detail: str,  # 详细说明\n485\t            must_output: str,  # 强制输出格式\n486\t        }\n487\t    \"\"\"\n488\t    # 获取跌幅\n489\t    change_pct = snap.get(\"pct\") if snap else None\n490\t    if change_pct is None and hist and hist.get(\"ok\"):\n491\t        change_pct = hist[\"latest\"].get(\"pct\")\n492\t\n493\t    # 获取量比（优先用snap，否则用hist的LR）\n494\t    volume_ratio = snap.get(\"volume_ratio\") if snap else None\n495\t    if volume_ratio is None and hist and hist.get(\"ok\"):\n496\t        # 用LR（量能火控）代替量比：今日量/MA20量\n497\t        volume_ratio = hist.get(\"lr\")\n498\t\n499\t    if change_pct is None:\n500\t        return {\n501\t            \"ok\": False,\n502\t            \"signal\": \"UNKNOWN\",\n503\t            \"detail\": \"跌幅数据不可用\",\n504\t        }\n505\t\n506\t    if volume_ratio is None:\n507\t        return {\n508\t            \"ok\": False,\n509\t            \"signal\": \"UNKNOWN\",\n510\t            \"detail\": \"量比/LR数据不可用\",\n511\t        }\n512\t\n513\t    abs_pct = abs(change_pct)\n514\t\n515\t    # === 第一层：量比+跌幅 硬规则 ===\n516\t    if volume_ratio > 2.0 and abs_pct > 5.0:\n517\t        signal = \"PANIC\"  # 恐慌出货\n518\t        base_action = \"立即清仓\"\n519\t        base_detail = f\"量比{volume_ratio}>2 且 跌幅{abs_pct}%>5% → 恐慌出货\"\n520\t    elif volume_ratio < 1.2 and abs_pct < 4.0:\n521\t        signal = \"NORMAL\"  # 缩量阴跌\n522\t        base_action = \"持有观察\"\n523\t        base_detail = f\"量比{volume_ratio}<1.2 且 跌幅{abs_pct}%<4% → 缩量阴跌，非恐慌\"\n524\t    else:\n525\t        signal = \"MIXED\"  # 混合信号，需要看分时\n526\t        base_action = \"需看分时成交量\"\n527\t        base_detail = f\"量比{volume_ratio}，跌幅{abs_pct}% → 混合信号\"\n528\t\n529\t    # === 第二层：分时成交量判断 ===\n530\t    minute_signal = \"NEUTRAL\"\n531\t    minute_detail = \"\"\n532\t\n533\t    try:\n534\t        minute_data = dl.get_minute_kline(code, scale=5, datalen=10)\n535\t        if minute_data.get(\"ok\") and minute_data.get(\"klines\"):\n536\t            klines = minute_data[\"klines\"]\n537\t            # 分析最近3-5根K线的量价关系\n538\t            recent = klines[-5:] if len(klines) >= 5 else klines\n539\t\n540\t            # 计算下跌量和上涨量\n541\t            down_volume = 0\n542\t            up_volume = 0\n543\t            for k in recent:\n544\t                if k[\"close\"] < k[\"open\"]:\n545\t                    down_volume += k[\"volume\"]\n546\t                else:\n547\t                    up_volume += k[\"volume\"]\n548\t\n549\t            total_volume = down_volume + up_volume\n550\t            if total_volume > 0:\n551\t                down_ratio = down_volume / total_volume\n552\t                up_ratio = up_volume / total_volume\n553\t\n554\t                if up_ratio > 0.6:\n555\t                    minute_signal = \"BOUNCE\"\n556\t                    minute_detail = f\"分时放量反弹(上涨量占{up_ratio*100:.0f}%)\"\n557\t                    if signal == \"PANIC\":\n558\t                        base_action = \"等反弹高点减仓\"\n559\t                    elif signal == \"NORMAL\":\n560\t                        base_action = \"持有，不要卖\"\n561\t                    else:  # MIXED\n562\t                        base_action = \"持有，不要卖\"\n563\t                elif down_ratio > 0.6:\n564\t                    minute_signal = \"SELLING\"\n565\t                    minute_detail = f\"分时放量下跌(下跌量占{down_ratio*100:.0f}%)\"\n566\t                    if signal == \"PANIC\":\n567\t                        base_action = \"立即清仓\"\n568\t                    elif signal == \"NORMAL\":\n569\t                        base_action = \"减仓1/2\"\n570\t                    else:  # MIXED\n571\t                        base_action = \"减仓1/2\"\n572\t                else:\n573\t                    minute_signal = \"NEUTRAL\"\n574\t                    minute_detail = \"分时量能均衡\"\n575\t    except Exception:\n576\t        minute_detail = \"分时数据获取失败\"\n577\t\n578\t    # === 第三层：综合信号 ===\n579\t    full_detail = f\"{base_detail}。{minute_detail}\"\n580\t\n581\t    # 强制输出格式\n582\t    vr_status = \"✅\" if volume_ratio < 2 else \"🔴\"\n583\t    pct_status = \"✅\" if abs_pct < 5 else \"🔴\"\n584\t    must_output = f\"\"\"【量价信号检查】\n585\t量比：{volume_ratio}（<2 {vr_status} / >2 🔴）\n586\t跌幅：-{abs_pct}%（<5% {pct_status} / >5% 🔴）\n587\t分时：{minute_detail}\n588\t判断：{signal}（{base_detail}）\n589\t建议：{base_action}\"\"\"\n590\t\n591\t    return {\n592\t        \"ok\": True,\n593\t        \"signal\": signal,\n594\t        \"volume_ratio\": volume_ratio,\n595\t        \"change_pct\": change_pct,\n596\t        \"minute_signal\": minute_signal,\n597\t        \"action\": base_action,\n598\t        \"detail\": full_detail,\n599\t        \"must_output\": must_output,\n600\t    }\n601\t\n602\t\n603\tdef analyze_fund_flow(snap, hist) -> dict:\n604\t    \"\"\"④ 资金动向：主力资金流接口被封，用成交额+换手近似推断。\"\"\"\n605\t    # 真实资金流接口(stock_individual_fund_flow)被限流，无法获取主力净流入\n606\t    # 降级方案：用换手率+涨跌幅+量能组合推断资金态度\n607\t    if not hist.get(\"ok\"):\n608\t        return {\"verdict\": \"数据不可用\", \"detail\": \"日K缺失\"}\n609\t\n610\t    pct = snap.get(\"pct\") if snap else hist[\"latest\"].get(\"pct\")\n611\t    lr = hist.get(\"lr\")\n612\t    turnover = snap.get(\"turnover\") if snap else hist[\"latest\"].get(\"turnover\")\n613\t\n614\t    if pct is None:\n615\t        return {\"verdict\": \"数据不足\", \"detail\": \"涨跌幅缺失\"}\n616\t\n617\t    # 降级推断规则\n618\t    if pct > 5 and lr and lr > 1.3:\n619\t        verdict = \"资金进场(推断)\"\n620\t        detail = f\"大涨{pct}%+放量(LR={lr})，推断主力资金净流入\"\n621\t    elif pct > 2 and lr and lr > 1.1:\n622\t        verdict = \"资金偏多(推断)\"\n623\t        detail = f\"上涨{pct}%+温和放量，资金态度偏多\"\n624\t    elif pct < -5 and lr and lr > 1.3:\n625\t        verdict = \"资金出逃(推断)\"\n626\t        detail = f\"大跌{pct}%+放量(LR={lr})，推断主力资金净流出/恐慌\"\n627\t    elif pct < -2 and lr and lr > 1.1:\n628\t        verdict = \"资金偏空(推断)\"\n629\t        detail = f\"下跌{pct}%+放量，资金态度偏空\"\n630\t    elif abs(pct) < 1 and lr and lr < 0.8:\n631\t        verdict = \"资金观望(推断)\"\n632\t        detail = f\"窄幅震荡+缩量，资金观望\"\n633\t    else:\n634\t        verdict = \"资金中性(推断)\"\n635\t        detail = f\"涨跌{pct}%，资金态度不明显\"\n636\t\n637\t    detail += \" ｜ ⚠️资金流接口被限流，以上为基于量价的降级推断，非真实主力数据\"\n638\t\n639\t    return {\"verdict\": verdict, \"detail\": detail, \"_degraded\": True}\n640\t\n641\t\n642\tdef analyze_accumulation_distribution(code: str, snap: dict, hist: dict,\n643\t                                       intraday_data: dict | None = None,\n644\t                                       trend: dict | None = None) -> dict:\n645\t    \"\"\"⑨ 筹码行为分析：判断放量是主力收集还是拉高出货（v0.85新增）。\n646\t\n647\t    五维度综合判断：\n648\t    1. 分时买卖盘力量比（tick-level 主动买入/卖出占比）\n649\t    2. 5分钟K线上涨量/下跌量比（分钟级别量价配合）\n650\t    3. 多日量价结构（日线级别积累/派发模式）\n651\t    4. 换手活跃度（换手率 vs 20日均值）\n652\t    5. 高位判定（60日区间位置 × 换手）\n653\t\n654\t    Returns:\n655\t        {\n656\t            ok: bool,\n657\t            verdict: str,   # \"收集(强)\" / \"收集\" / \"派发(强)\" / \"派发\" / \"换手(中性)\" / \"不明确\"\n658\t            score: int,     # -5(强派发) ~ +5(强收集)\n659\t            signals: list,  # 各维度信号描述\n660\t            buy_ratio: float | None,   # 主动买入占比\n661\t            sell_ratio: float | None,  # 主动卖出占比\n662\t            detail: str,\n663\t            _degraded: bool,\n664\t        }\n665\t    \"\"\"\n666\t    signals = []\n667\t    score = 0\n668\t    buy_ratio = None\n669\t    sell_ratio = None\n670\t    degraded = False\n671\t\n672\t    # ============================================================\n673\t    # 维度1：分时买卖盘力量比（最直接的庄家行为指标）\n674\t    # ============================================================\n675\t    if intraday_data and intraday_data.get(\"ok\"):\n676\t        bv = intraday_data.get(\"buy_vol\", 0)\n677\t        sv = intraday_data.get(\"sell_vol\", 0)\n678\t        nv = intraday_data.get(\"neutral_vol\", 0)\n679\t        total_bs = bv + sv + nv\n680\t\n681\t        if total_bs > 0 and intraday_data.get(\"has_bs_data\"):\n682\t            buy_ratio = round(bv / total_bs, 3)\n683\t            sell_ratio = round(sv / total_bs, 3)\n684\t\n685\t            if buy_ratio > 0.60:\n686\t                score += 2\n687\t                signals.append(f\"🟢 主动买入占{buy_ratio:.0%}(>60%)，买方主导\")\n688\t            elif buy_ratio > 0.52:\n689\t                score += 1\n690\t                signals.append(f\"🟢 主动买入占{buy_ratio:.0%}(>52%)，买方偏强\")\n691\t            elif sell_ratio > 0.60:\n692\t                score -= 2\n693\t                signals.append(f\"🔴 主动卖出占{sell_ratio:.0%}(>60%)，卖方主导\")\n694\t            elif sell_ratio > 0.52:\n695\t                score -= 1\n696\t                signals.append(f\"🟡 主动卖出占{sell_ratio:.0%}(>52%)，卖方偏强\")\n697\t            else:\n698\t                signals.append(f\"⚪ 买卖均衡(买{buy_ratio:.0%}/卖{sell_ratio:.0%})\")\n699\t        elif total_bs > 0:\n700\t            # 有成交量但无买卖分类 → 用 tick 价格方向推断\n701\t            ticks = intraday_data.get(\"ticks\", [])\n702\t            up_hands, down_hands = 0, 0\n703\t            for i in range(1, len(ticks)):\n704\t                if ticks[i][\"price\"] > ticks[i-1][\"price\"]:\n705\t                    up_hands += ticks[i][\"hands\"]\n706\t                elif ticks[i][\"price\"] < ticks[i-1][\"price\"]:\n707\t                    down_hands += ticks[i][\"hands\"]\n708\t            total_ud = up_hands + down_hands\n709\t            if total_ud > 0:\n710\t                up_r = up_hands / total_ud\n711\t                if up_r > 0.60:\n712\t                    score += 1\n713\t                    signals.append(f\"🟢 tick上行量占{up_r:.0%}(推断买方偏强，无BS分类)\")\n714\t                elif up_r < 0.40:\n715\t                    score -= 1\n716\t                    signals.append(f\"🔴 tick下行量占{1-up_r:.0%}(推断卖方偏强，无BS分类)\")\n717\t                else:\n718\t                    signals.append(f\"⚪ tick方向均衡(上行{up_r:.0%}，无BS分类)\")\n719\t            degraded = True\n720\t        else:\n721\t            signals.append(\"⚪ 分时买卖盘数据为空\")\n722\t            degraded = True\n723\t    else:\n724\t        signals.append(\"⚪ 分时数据不可用(盘后/限流)\")\n725\t        degraded = True\n726\t\n727\t    # ============================================================\n728\t    # 维度2：5分钟K线量价配合（分钟级别量价背离检测）\n729\t    # ============================================================\n730\t    mk = dl.get_minute_kline(code, scale=5, datalen=20)\n731\t    if mk.get(\"ok\") and mk.get(\"klines\"):\n732\t        klines = mk[\"klines\"]\n733\t        up_vol, down_vol = 0, 0\n734\t        up_count, down_count = 0, 0\n735\t        recent_spike = False  # 最近5根是否有冲高回落放量\n736\t\n737\t        for i, k in enumerate(klines):\n738\t            vol = k.get(\"volume\", 0)\n739\t            if k[\"close\"] >= k[\"open\"]:\n740\t                up_vol += vol\n741\t                up_count += 1\n742\t            else:\n743\t                down_vol += vol\n744\t                down_count += 1\n745\t\n746\t            # 检测冲高回落放量（上影线长 + 收盘偏低 = 典型出货）\n747\t            if i >= len(klines) - 5:\n748\t                bar_range = k[\"high\"] - k[\"low\"]\n749\t                if bar_range > 0:\n750\t                    upper_shadow = k[\"high\"] - max(k[\"open\"], k[\"close\"])\n751\t                    if (upper_shadow / bar_range > 0.5\n752\t                            and k[\"close\"] < (k[\"high\"] + k[\"low\"]) / 2\n753\t                            and vol > 0):\n754\t                        recent_spike = True\n755\t\n756\t        total_mvol = up_vol + down_vol\n757\t        if total_mvol > 0 and (up_count + down_count) > 0:\n758\t            up_vol_r = up_vol / total_mvol\n759\t            if up_vol_r > 0.60:\n760\t                score += 1\n761\t                signals.append(f\"🟢 5min上涨量占{up_vol_r:.0%}(量价配合)\")\n762\t            elif up_vol_r < 0.40:\n763\t                score -= 1\n764\t                signals.append(f\"🔴 5min下跌量占{1-up_vol_r:.0%}(下跌放量)\")\n765\t\n766\t            if recent_spike:\n767\t                score -= 1\n768\t                signals.append(\"🔴 近5根5minK线冲高回落放量(派发特征)\")\n769\t\n770\t    # ============================================================\n771\t    # 维度3：多日量价结构（日线级别收集/派发模式识别）\n772\t    # ============================================================\n773\t    if hist.get(\"ok\"):\n774\t        closes = hist.get(\"closes\", [])\n775\t        volumes = hist.get(\"volumes\", [])\n776\t\n777\t        if len(closes) >= 6 and len(volumes) >= 6:\n778\t            recent_n = min(5, len(closes) - 1)\n779\t            # 逐日量价关系统计\n780\t            up_with_vol, down_with_vol = 0, 0\n781\t            vol_rising, vol_falling = 0, 0\n782\t\n783\t            for i in range(-recent_n, 0):\n784\t                pct_d = (closes[i] - closes[i-1]) / closes[i-1] if closes[i-1] else 0\n785\t                vol_d = (volumes[i] - volumes[i-1]) / volumes[i-1] if volumes[i-1] else 0\n786\t\n787\t                if pct_d > 0.005 and vol_d > 0:\n788\t                    up_with_vol += 1  # 放量上涨\n789\t                elif pct_d < -0.005 and vol_d > 0:\n790\t                    down_with_vol += 1  # 放量下跌\n791\t                if vol_d > 0:\n792\t                    vol_rising += 1\n793\t                else:\n794\t                    vol_falling += 1\n795\t\n796\t            # 整体趋势方向\n797\t            price_rising = closes[-1] > closes[-recent_n]\n798\t            avg_recent_vol = sum(volumes[-recent_n:]) / recent_n\n799\t            avg_vol_20 = sum(volumes[-min(20, len(volumes)):]) / min(20, len(volumes))\n800\t\n801\t            if up_with_vol >= 3:\n802\t                score += 1\n803\t                signals.append(f\"🟢 近{recent_n}日{up_with_vol}次放量上涨(积累)\")\n804\t            elif down_with_vol >= 3:\n805\t                score -= 1\n806\t                signals.append(f\"🔴 近{recent_n}日{down_with_vol}次放量下跌(派发)\")\n807\t            elif price_rising and vol_falling > vol_rising:\n808\t                score -= 1\n809\t                signals.append(f\"🟡 价涨量缩({vol_falling}日缩量/{vol_rising}日放量)，顶背离迹象\")\n810\t            elif not price_rising and vol_rising > vol_falling:\n811\t                # 价格不涨但放量 → 高位派发特征\n812\t                score -= 1\n813\t                signals.append(f\"🟡 放量但价格不涨({vol_rising}日放量)，滞涨派发迹象\")\n814\t\n815\t            # 放量滞涨检测（经典派发信号）\n816\t            if avg_vol_20 > 0:\n817\t                vol_expand = (avg_recent_vol - avg_vol_20) / avg_vol_20\n818\t                price_chg = (closes[-1] - closes[-recent_n]) / closes[-recent_n] if closes[-recent_n] else 0\n819\t                if vol_expand > 0.3 and abs(price_chg) < 0.02:\n820\t                    score -= 1\n821\t                    signals.append(f\"🔴 近{recent_n}日放量{vol_expand:.0%}但价格仅变{price_chg:.1%}(放量滞涨=派发)\")\n822\t                elif vol_expand > 0.1 and price_chg > 0.03:\n823\t                    score += 1\n824\t                    signals.append(f\"🟢 近{recent_n}日放量{vol_expand:.0%}+涨{price_chg:.1%}(量价齐升=收集)\")\n825\t\n826\t    # ============================================================\n827\t    # 维度4：换手活跃度\n828\t    # ============================================================\n829\t    turnover = snap.get(\"turnover\") if snap else None\n830\t    if turnover is None and hist.get(\"ok\"):\n831\t        turnover = hist[\"latest\"].get(\"turnover\")\n832\t\n833\t    if turnover and hist.get(\"ok\"):\n834\t        vols = hist.get(\"volumes\", [])\n835\t        if len(vols) >= 20:\n836\t            avg_vol_20 = sum(vols[-20:]) / 20\n837\t            latest_vol = vols[-1] if vols else 0\n838\t            if avg_vol_20 > 0:\n839\t                vol_ratio = latest_vol / avg_vol_20\n840\t                if vol_ratio > 2.0:\n841\t                    if turnover > 10:\n842\t                        signals.append(f\"🔴 换手{turnover}%极高(>{vol_ratio:.1f}x均量)，警惕对倒出货\")\n843\t                        score -= 1\n844\t                    else:\n845\t                        signals.append(f\"🟡 放量{vol_ratio:.1f}x均量，换手{turnover}%，需结合方向判断\")\n846\t                elif vol_ratio < 0.5:\n847\t                    signals.append(f\"⚪ 缩量{vol_ratio:.1f}x均量，换手{turnover}%，观望\")\n848\t\n849\t    # ============================================================\n850\t    # 维度5：高位判定（60日区间位置）\n851\t    # ============================================================\n852\t    if hist.get(\"ok\"):\n853\t        closes60 = hist.get(\"closes60\", [])\n854\t        highs60 = hist.get(\"highs60\", [])\n855\t        lows60 = hist.get(\"lows60\", [])\n856\t        price = snap.get(\"price\") if snap else None\n857\t        if not price and hist.get(\"ok\"):\n858\t            price = hist[\"latest\"].get(\"price\")\n859\t\n860\t        if price and highs60 and lows60:\n861\t            high60 = max(highs60)\n862\t            low60 = min(lows60)\n863\t            range60 = high60 - low60\n864\t            if range60 > 0:\n865\t                position = (price - low60) / range60\n866\t                pos_label = \"高位\" if position > 0.8 else (\"中位\" if position > 0.5 else \"低位\")\n867\t\n868\t                if position > 0.8:\n869\t                    if turnover and turnover > 8:\n870\t                        score -= 1\n871\t                        signals.append(f\"🔴 60日{pos_label}({position:.0%})+高换手{turnover}%=高位派发风险\")\n872\t                    else:\n873\t                        signals.append(f\"🟡 60日{pos_label}({position:.0%})，关注是否放量出货\")\n874\t                elif position < 0.3:\n875\t                    score += 1\n876\t                    signals.append(f\"🟢 60日{pos_label}({position:.0%})，底部区间利于收集\")\n877\t\n878\t    # ============================================================\n879\t    # 综合判定\n880\t    # ============================================================\n881\t    score = max(-5, min(5, score))\n882\t\n883\t    if score >= 3:\n884\t        verdict = \"收集(强)\"\n885\t        icon = \"🟢🟢\"\n886\t    elif score >= 1:\n887\t        verdict = \"收集\"\n888\t        icon = \"🟢\"\n889\t    elif score <= -3:\n890\t        verdict = \"派发(强)\"\n891\t        icon = \"🔴🔴\"\n892\t    elif score <= -1:\n893\t        verdict = \"派发\"\n894\t        icon = \"🔴\"\n895\t    elif score == 0 and len(signals) > 0:\n896\t        verdict = \"换手(中性)\"\n897\t        icon = \"⚪\"\n898\t    else:\n899\t        verdict = \"不明确\"\n900\t        icon = \"❓\"\n901\t\n902\t    detail_parts = [f\"{icon} 筹码行为: {verdict}(评分{score:+d})\"]\n903\t    for s in signals:\n904\t        detail_parts.append(f\"  {s}\")\n905\t\n906\t    return {\n907\t        \"ok\": True,\n908\t        \"verdict\": verdict,\n909\t        \"score\": score,\n910\t        \"signals\": signals,\n911\t        \"buy_ratio\": buy_ratio,\n912\t        \"sell_ratio\": sell_ratio,\n913\t        \"detail\": \"\\n\".join(detail_parts),\n914\t        \"_degraded\": degraded,\n915\t    }\n916\t\n917\t\n918\tdef analyze_relative_strength(snap, code, pool_meta=None) -> dict:\n919\t    \"\"\"⑤ 相对强弱（核心）：个股 vs 大盘 vs 板块 vs 龙头 四象限。\"\"\"\n920\t    stock_pct = snap.get(\"pct\") if snap else None\n921\t    if stock_pct is None:\n922\t        return {\"verdict\": \"数据不可用\", \"detail\": \"个股涨跌幅缺失\"}\n923\t\n924\t    # 大盘：用沪深300\n925\t    idx = dl.get_index_daily(\"sh000300\")\n926\t    index_pct = idx.get(\"pct\") if idx.get(\"ok\") else None\n927\t\n928\t    # 板块：从新浪板块涨跌里找（用别名映射匹配）\n929\t    config_sector = dl.find_sector_of(code, pool_meta)\n930\t    sector_name = config_sector  # 显示用配置名\n931\t    matched_sector = None\n932\t    sector_pct = None\n933\t    sb = dl.get_sector_board()\n934\t    if sb.get(\"ok\") and config_sector:\n935\t        matched_sector = dl.match_sector_in_board(config_sector, sb[\"sectors\"])\n936\t        if matched_sector:\n937\t            sector_pct = matched_sector.get(\"pct\")\n938\t            sector_name = matched_sector.get(\"name\")  # 用实际匹配到的板块名\n939\t        else:\n940\t            sector_name = config_sector  # 未匹配则保留配置名\n941\t\n942\t    # 计算超额收益\n943\t    excess_vs_index = round(stock_pct - index_pct, 2) if index_pct is not None else None\n944\t    excess_vs_sector = round(stock_pct - sector_pct, 2) if sector_pct is not None else None\n945\t\n946\t    # 综合判定\n947\t    parts = []\n948\t    if excess_vs_index is not None:\n949\t        if excess_vs_index > 2:\n950\t            parts.append(\"显著强于大盘\")\n951\t        elif excess_vs_index > 0:\n952\t            parts.append(\"强于大盘\")\n953\t        elif excess_vs_index < -2:\n954\t            parts.append(\"显著弱于大盘\")\n955\t        else:\n956\t            parts.append(\"弱于大盘\")\n957\t\n958\t    if excess_vs_sector is not None:\n959\t        if excess_vs_sector > 2:\n960\t            parts.append(\"领涨板块\")\n961\t        elif excess_vs_sector > 0:\n962\t            parts.append(\"强于板块\")\n963\t        elif excess_vs_sector < -2:\n964\t            parts.append(\"板块掉队\")\n965\t        else:\n966\t            parts.append(\"弱于板块\")\n967\t\n968\t    if not parts:\n969\t        verdict = \"参照数据不全\"\n970\t        detail = \"无法获取大盘或板块涨跌\"\n971\t    else:\n972\t        verdict = \"，\".join(parts)\n973\t        detail = f\"个股{stock_pct}%\"\n974\t        if index_pct is not None:\n975\t            detail += f\"，大盘{index_pct}%(超额{excess_vs_index}%)\"\n976\t        if sector_pct is not None:\n977\t            detail += f\"，板块「{sector_name}」{sector_pct}%(相对{excess_vs_sector}%)\"\n978\t\n979\t    # 操作含义\n980\t    if excess_vs_index is not None and excess_vs_index < 0 and stock_pct > 0:\n981\t        detail += \" ｜ ⚠️涨但跑输大盘，属被动跟涨，独立性差\"\n982\t    if excess_vs_sector is not None and excess_vs_sector < -1:\n983\t        detail += \" ｜ ⚠️明显弱于板块，可能掉队，不宜追高\"\n984\t\n985\t    return {\n986\t        \"verdict\": verdict,\n987\t        \"comparison\": {\n988\t            \"stock_pct\": stock_pct,\n989\t            \"index_pct\": index_pct,\n990\t            \"excess_vs_index\": excess_vs_index,\n991\t            \"sector_name\": sector_name,\n992\t            \"sector_pct\": sector_pct,\n993\t            \"excess_vs_sector\": excess_vs_sector,\n994\t        },\n995\t        \"detail\": detail,\n996\t    }\n997\t\n998\t\n999\tdef calc_key_levels(price, hist, pool_meta=None) -> dict:\n1000\t    \"\"\"⑥ 关键技术位：支撑/压力/止损（v0.85增强）。\n1001\t\n1002\t    新增：黄金分割回撤位、MA60、布林带上下轨、60日高低、整数关口。\n1003\t    返回结构化 supports[]/resistances[] 列表 + 兼容旧字段 support/resistance/stop_loss。\n1004\t    \"\"\"\n1005\t    if not hist.get(\"ok\"):\n1006\t        return {\"verdict\": \"数据不可用\"}\n1007\t\n1008\t    ma5 = hist.get(\"ma5\")\n1009\t    ma10 = hist.get(\"ma10\")\n1010\t    ma20 = hist.get(\"ma20\")\n1011\t    ma60 = hist.get(\"ma60\")\n1012\t    recent_high20 = hist.get(\"recent_high20\")\n1013\t    recent_low20 = hist.get(\"recent_low20\")\n1014\t    p = price if price else hist[\"latest\"][\"close\"]\n1015\t\n1016\t    # ---------- 60日高低 ----------\n1017\t    highs60 = hist.get(\"highs60\", [])\n1018\t    lows60 = hist.get(\"lows60\", [])\n1019\t    closes60 = hist.get(\"closes60\", [])\n1020\t    high60 = max(highs60) if highs60 else None\n1021\t    low60 = min(lows60) if lows60 else None\n1022\t\n1023\t    # ---------- 黄金分割回撤位（基于60日高低点） ----------\n1024\t    fib_levels = []\n1025\t    if high60 and low60 and high60 > low60:\n1026\t        diff = high60 - low60\n1027\t        for ratio in [0.236, 0.382, 0.5, 0.618, 0.786]:\n1028\t            val = round(high60 - diff * ratio, 2)\n1029\t            fib_levels.append({\"level\": val, \"label\": f\"Fib {ratio}\"})\n1030\t\n1031\t    # ---------- 布林带（MA20 ± 2σ） ----------\n1032\t    boll_upper = None\n1033\t    boll_lower = None\n1034\t    if len(closes60) >= 20:\n1035\t        ma20_slice = closes60[-20:]\n1036\t        mean20 = sum(ma20_slice) / 20\n1037\t        variance = sum((c - mean20) ** 2 for c in ma20_slice) / 20\n1038\t        std20 = variance ** 0.5\n1039\t        boll_upper = round(mean20 + 2 * std20, 2)\n1040\t        boll_lower = round(mean20 - 2 * std20, 2)\n1041\t\n1042\t    # ---------- 整数关口（现价上下各2个） ----------\n1043\t    round_numbers = []\n1044\t    if p and p > 0:\n1045\t        magnitude = 10 ** max(0, len(str(int(p))) - 1)  # 10/100/1000\n1046\t        if magnitude < 10:\n1047\t            magnitude = 10\n1048\t        base = int(p / magnitude) * magnitude\n1049\t        for offset in [-2, -1, 0, 1, 2]:\n1050\t            rn = base + offset * magnitude\n1051\t            if rn > 0 and rn != int(p):\n1052\t                round_numbers.append(rn)\n1053\t\n1054\t    # ========== 构建支撑位列表（现价下方） ==========\n1055\t    supports = []\n1056\t    # 均线支撑\n1057\t    for label, val in [(\"MA5\", ma5), (\"MA10\", ma10), (\"MA20\", ma20), (\"MA60\", ma60)]:\n1058\t        if val and val < p:\n1059\t            supports.append({\"level\": val, \"label\": label, \"type\": \"ma\"})\n1060\t    # 布林带下轨\n1061\t    if boll_lower and boll_lower < p:\n1062\t        supports.append({\"level\": boll_lower, \"label\": \"BOLL下轨\", \"type\": \"boll\"})\n1063\t    # 黄金分割（现价下方）\n1064\t    for f in fib_levels:\n1065\t        if f[\"level\"] < p:\n1066\t            supports.append({\"level\": f[\"level\"], \"label\": f[\"label\"], \"type\": \"fib\"})\n1067\t    # 20日/60日低点\n1068\t    if recent_low20 and recent_low20 < p:\n1069\t        supports.append({\"level\": recent_low20, \"label\": \"20日低点\", \"type\": \"swing\"})\n1070\t    if low60 and low60 < p and low60 != recent_low20:\n1071\t        supports.append({\"level\": low60, \"label\": \"60日低点\", \"type\": \"swing\"})\n1072\t    # 整数关口（现价下方）\n1073\t    for rn in round_numbers:\n1074\t        if rn < p:\n1075\t            supports.append({\"level\": rn, \"label\": f\"整数{rn}\", \"type\": \"round\"})\n1076\t\n1077\t    # 按价格从高到低排序（最近的支撑排前面）\n1078\t    supports.sort(key=lambda x: x[\"level\"], reverse=True)\n1079\t    # 去重（同价位保留type优先级更高的）\n1080\t    seen_levels = set()\n1081\t    unique_supports = []\n1082\t    type_priority = {\"ma\": 0, \"boll\": 1, \"fib\": 2, \"swing\": 3, \"round\": 4}\n1083\t    for s in supports:\n1084\t        rounded = round(s[\"level\"], 1)  # 0.1元内视为同价位\n1085\t        if rounded not in seen_levels:\n1086\t            seen_levels.add(rounded)\n1087\t            unique_supports.append(s)\n1088\t    supports = unique_supports[:8]  # 最多保留8层\n1089\t\n1090\t    # ========== 构建压力位列表（现价上方） ==========\n1091\t    resistances = []\n1092\t    for label, val in [(\"MA5\", ma5), (\"MA10\", ma10), (\"MA20\", ma20), (\"MA60\", ma60)]:\n1093\t        if val and val > p:\n1094\t            resistances.append({\"level\": val, \"label\": label, \"type\": \"ma\"})\n1095\t    if boll_upper and boll_upper > p:\n1096\t        resistances.append({\"level\": boll_upper, \"label\": \"BOLL上轨\", \"type\": \"boll\"})\n1097\t    for f in fib_levels:\n1098\t        if f[\"level\"] > p:\n1099\t            resistances.append({\"level\": f[\"level\"], \"label\": f[\"label\"], \"type\": \"fib\"})\n1100\t    if recent_high20 and recent_high20 > p:\n1101\t        resistances.append({\"level\": recent_high20, \"label\": \"20日高点\", \"type\": \"swing\"})\n1102\t    if high60 and high60 > p and high60 != recent_high20:\n1103\t        resistances.append({\"level\": high60, \"label\": \"60日高点\", \"type\": \"swing\"})\n1104\t    for rn in round_numbers:\n1105\t        if rn > p:\n1106\t            resistances.append({\"level\": rn, \"label\": f\"整数{rn}\", \"type\": \"round\"})\n1107\t\n1108\t    resistances.sort(key=lambda x: x[\"level\"])  # 最近的压力排前面\n1109\t    seen_levels = set()\n1110\t    unique_resistances = []\n1111\t    for r in resistances:\n1112\t        rounded = round(r[\"level\"], 1)\n1113\t        if rounded not in seen_levels:\n1114\t            seen_levels.add(rounded)\n1115\t            unique_resistances.append(r)\n1116\t    resistances = unique_resistances[:8]\n1117\t\n1118\t    # ========== 兼容旧字段 ==========\n1119\t    support = supports[0][\"level\"] if supports else None\n1120\t    resistance = resistances[0][\"level\"] if resistances else None\n1121\t\n1122\t    # 止损：优先持仓池配置 → MA20下方2% → 最近支撑下方2%\n1123\t    # v0.93 新增：止损位合理性校验，防止陈旧数据（除权/拆股后未更新）导致止损位失真\n1124\t    stop_loss = None\n1125\t    stop_loss_source = \"none\"\n1126\t\n1127\t    if pool_meta and pool_meta.get(\"stop_loss\"):\n1128\t        pool_sl = pool_meta[\"stop_loss\"]\n1129\t        # 合理性检查：止损位与现价偏差超过50%视为陈旧数据\n1130\t        if price and price > 0:\n1131\t            deviation_pct = abs(pool_sl - price) / price * 100\n1132\t            if deviation_pct <= 50:\n1133\t                stop_loss = pool_sl\n1134\t                stop_loss_source = \"pool_meta\"\n1135\t            else:\n1136\t                # 止损位严重偏离，降级为MA20计算\n1137\t                print(f\"  [WARN] 300476 池子止损位{pool_sl}与现价{price}偏差{deviation_pct:.1f}%，疑似陈旧数据，改用MA20计算\")\n1138\t                if ma20:\n1139\t                    stop_loss = round(ma20 * 0.98, 2)\n1140\t                    stop_loss_source = \"ma20_fallback\"\n1141\t                elif support:\n1142\t                    stop_loss = round(support * 0.98, 2)\n1143\t                    stop_loss_source = \"support_fallback\"\n1144\t        else:\n1145\t            # 无法获取现价，直接使用池子数据（保守）\n1146\t            stop_loss = pool_sl\n1147\t            stop_loss_source = \"pool_meta_no_price_check\"\n1148\t\n1149\t    if stop_loss is None:\n1150\t        if ma20:\n1151\t            stop_loss = round(ma20 * 0.98, 2)\n1152\t            stop_loss_source = \"ma20\"\n1153\t        elif support:\n1154\t            stop_loss = round(support * 0.98, 2)\n1155\t            stop_loss_source = \"support\"\n1156\t\n1157\t    # ========== 详情文本 ==========\n1158\t    detail_parts = []\n1159\t    if supports:\n1160\t        top_sup = supports[:3]\n1161\t        detail_parts.append(\"支撑: \" + \" / \".join(f\"{s['label']}({s['level']})\" for s in top_sup))\n1162\t    if resistances:\n1163\t        top_res = resistances[:3]\n1164\t        detail_parts.append(\"压力: \" + \" / \".join(f\"{r['label']}({r['level']})\" for r in top_res))\n1165\t    if stop_loss:\n1166\t        source_tag = f\"({stop_loss_source})\" if stop_loss_source != \"pool_meta\" else \"\"\n1167\t        detail_parts.append(f\"止损{stop_loss}{source_tag}\")\n1168\t    if boll_upper and boll_lower:\n1169\t        detail_parts.append(f\"BOLL [{boll_lower}-{boll_upper}]\")\n1170\t\n1171\t    return {\n1172\t        \"support\": support,\n1173\t        \"resistance\": resistance,\n1174\t        \"stop_loss\": stop_loss,\n1175\t        \"stop_loss_source\": stop_loss_source,\n1176\t        \"supports\": supports,\n1177\t        \"resistances\": resistances,\n1178\t        \"fib_levels\": fib_levels,\n1179\t        \"boll\": {\"upper\": boll_upper, \"lower\": boll_lower},\n1180\t        \"range60\": {\"high\": high60, \"low\": low60},\n1181\t        \"detail\": \"，\".join(detail_parts) if detail_parts else \"技术位数据不足\",\n1182\t    }\n1183\t\n1184\t\n1185\tdef calc_trade_prices(hist: dict, levels: dict, trend: dict, lr: float = None, volprice: dict = None, price: float = None) -> dict:\n1186\t    \"\"\"回踩/突破策略价格计算（v0.85新增）。\n1187\t\n1188\t    根据趋势判断(多头=回踩策略, 空头/缠绕=突破策略)输出两套买入方案，\n1189\t    含价格区间、止损、R:R风险收益比。\n1190\t\n1191\t    Args:\n1192\t        hist: get_stock_hist() 返回值\n1193\t        levels: calc_key_levels() 返回值\n1194\t        trend: analyze_trend() 返回值\n1195\t        lr: 当前量能火控值（可选，用于判断量能条件）\n1196\t\n1197\t    Returns:\n1198\t        dict: {strategy, plans[], recommendation, rr}\n1199\t    \"\"\"\n1200\t    if not hist.get(\"ok\"):\n1201\t        return {\"ok\": False, \"strategy\": \"数据不可用\", \"plans\": []}\n1202\t\n1203\t    price = hist[\"latest\"][\"close\"]\n1204\t    ma5 = hist.get(\"ma5\")\n1205\t    ma10 = hist.get(\"ma10\")\n1206\t    ma20 = hist.get(\"ma20\")\n1207\t    tv = trend.get(\"verdict\", \"\")\n1208\t    supports = levels.get(\"supports\", [])\n1209\t    resistances = levels.get(\"resistances\", [])\n1210\t    stop_loss_pool = levels.get(\"stop_loss\")\n1211\t\n1212\t    plans = []\n1213\t\n1214\t    # v0.90新增：回踩vs破位判定 + 量价异常拦截\n1215\t    actual_price = price if price else hist[\"latest\"][\"close\"]\n1216\t    pb_breakdown = classify_pullback_vs_breakdown(hist, actual_price, lr=lr)\n1217\t\n1218\t    # v0.90新增：量价异常检查——放量下跌时拦截回踩买入\n1219\t    volprice_warning = False\n1220\t    volprice_detail = \"\"\n1221\t    if volprice and volprice.get(\"detail\"):\n1222\t        volprice_detail = volprice.get(\"detail\", \"\")\n1223\t        if \"跌而放量\" in volprice_detail or \"恐慌/出货\" in volprice_detail:\n1224\t            volprice_warning = True\n1225\t\n1226\t    # ====== 方案A：回踩策略（多头排列 / 缠绕偏多） ======\n1227\t    is_bullish = \"多头\" in tv\n1228\t    is_neutral = \"缠绕\" in tv\n1229\t    # v0.90新增：破位判定或量价异常时，跳过回踩方案\n1230\t    if (is_bullish or is_neutral) and pb_breakdown.get(\"classification\") == \"BREAKDOWN\":\n1231\t        plans.append({\n1232\t            \"name\": \"方案A: 回踩买入(已拦截)\",\n1233\t            \"strategy\": \"pullback_blocked\",\n1234\t            \"buy_zone\": \"N/A\",\n1235\t            \"buy_target\": None,\n1236\t            \"sell_target\": None,\n1237\t            \"stop_loss\": None,\n1238\t            \"rr\": None,\n1239\t            \"lr_condition\": \"N/A\",\n1240\t            \"lr_met\": False,\n1241\t            \"lr_current\": lr,\n1242\t            \"conditions\": [\n1243\t                f\"⚠️破位判定拦截：{pb_breakdown.get('reason', '')}\",\n1244\t                \"回踩买入方案已拦截，等待趋势企稳\",\n1245\t            ],\n1246\t            \"blocked\": True,\n1247\t            \"block_reason\": pb_breakdown.get(\"reason\", \"破位信号\"),\n1248\t        })\n1249\t    elif (is_bullish or is_neutral) and volprice_warning:\n1250\t        plans.append({\n1251\t            \"name\": \"方案A: 回踩买入(已拦截)\",\n1252\t            \"strategy\": \"pullback_blocked\",\n1253\t            \"buy_zone\": \"N/A\",\n1254\t            \"buy_target\": None,\n1255\t            \"sell_target\": None,\n1256\t            \"stop_loss\": None,\n1257\t            \"rr\": None,\n1258\t            \"lr_condition\": \"N/A\",\n1259\t            \"lr_met\": False,\n1260\t            \"lr_current\": lr,\n1261\t            \"conditions\": [\n1262\t                f\"⚠️量价异常拦截：{volprice_detail}\",\n1263\t                \"放量下跌信号，回踩买入方案已拦截\",\n1264\t            ],\n1265\t            \"blocked\": True,\n1266\t            \"block_reason\": f\"量价异常：{volprice_detail}\",\n1267\t        })\n1268\t    elif is_bullish or is_neutral:\n1269\t        # 买入价：最近的均线支撑（MA5/MA10），给一个小范围\n1270\t        buy_candidates = []\n1271\t        for s in supports:\n1272\t            if s[\"type\"] == \"ma\" and s[\"level\"] < price:\n1273\t                buy_candidates.append(s[\"level\"])\n1274\t        if not buy_candidates and ma10:\n1275\t            buy_candidates.append(ma10)\n1276\t        if not buy_candidates and ma20:\n1277\t            buy_candidates.append(ma20)\n1278\t\n1279\t        if buy_candidates:\n1280\t            buy_target = max(buy_candidates)  # 最近的均线支撑\n1281\t            buy_low = round(buy_target * 0.99, 2)  # 下方1%的容差\n1282\t            buy_high = round(buy_target * 1.005, 2)  # 上方0.5%\n1283\t\n1284\t            # 止盈：第一个压力位，且保证R:R≥1.2\n1285\t            sell_target = None\n1286\t            for r in resistances:\n1287\t                risk = buy_target - (stop_loss_pool or buy_target * 0.97)\n1288\t                if risk > 0 and (r[\"level\"] - buy_target) / risk >= 1.2:\n1289\t                    sell_target = r[\"level\"]\n1290\t                    break\n1291\t            if sell_target is None and resistances:\n1292\t                sell_target = resistances[0][\"level\"]\n1293\t            if sell_target is None:\n1294\t                sell_target = round(buy_target * 1.10, 2)  # 兜底10%\n1295\t\n1296\t            # 止损\n1297\t            stop = stop_loss_pool\n1298\t            if stop is None:\n1299\t                # 用次一级支撑下方2%\n1300\t                next_supports = [s[\"level\"] for s in supports if s[\"level\"] < buy_target]\n1301\t                if next_supports:\n1302\t                    stop = round(max(next_supports) * 0.98, 2)\n1303\t                else:\n1304\t                    stop = round(buy_target * 0.97, 2)  # 买入价下方3%\n1305\t\n1306\t            # R:R\n1307\t            risk = buy_target - stop if stop else buy_target * 0.03\n1308\t            reward = sell_target - buy_target if sell_target else buy_target * 0.10\n1309\t            rr = round(reward / risk, 2) if risk > 0 else None\n1310\t\n1311\t            # LR条件（回踩建仓 LR≥0.8）\n1312\t            lr_condition = \"回踩日缩量(LR<0.8)+买入日放量(LR≥0.8)\"\n1313\t            lr_met = lr is not None and lr >= 0.8\n1314\t\n1315\t            plans.append({\n1316\t                \"name\": \"方案A: 回踩买入\",\n1317\t                \"strategy\": \"pullback\",\n1318\t                \"buy_zone\": f\"{buy_low}-{buy_high}\",\n1319\t                \"buy_target\": buy_target,\n1320\t                \"sell_target\": sell_target,\n1321\t                \"stop_loss\": stop,\n1322\t                \"rr\": rr,\n1323\t                \"lr_condition\": lr_condition,\n1324\t                \"lr_met\": lr_met,\n1325\t                \"lr_current\": lr,\n1326\t                \"conditions\": [\n1327\t                    f\"价格回踩{buy_target}附近(MA支撑)\",\n1328\t                    f\"回踩日缩量(LR<0.8)+买入日放量(LR≥0.8)\",\n1329\t                    f\"composite_shock≤2\",\n1330\t                    f\"当日涨>5%不追/高开>3%不追\",\n1331\t                ],\n1332\t            })\n1333\t\n1334\t    # ====== 方案B：突破策略（任何趋势均可） ======\n1335\t    if ma5 and ma10:\n1336\t        # 突破确认价：MA5×1.01（站上MA5+1%确认突破）\n1337\t        break_price = round(ma5 * 1.01, 2)\n1338\t\n1339\t        # 止损：MA5下方2% 或 最近支撑下方2%\n1340\t        stop_b = round(ma5 * 0.98, 2)\n1341\t        if supports:\n1342\t            nearest_below = [s[\"level\"] for s in supports if s[\"level\"] < break_price]\n1343\t            if nearest_below:\n1344\t                alt_stop = round(max(nearest_below) * 0.98, 2)\n1345\t                stop_b = max(stop_b, alt_stop)\n1346\t\n1347\t        # 止盈：保证R:R≥1.5\n1348\t        risk_b = break_price - stop_b\n1349\t        min_reward_b = risk_b * 1.5\n1350\t        sell_b = round(break_price + min_reward_b, 2)\n1351\t        # 尝试用压力位\n1352\t        for r in resistances:\n1353\t            if r[\"level\"] > break_price and (r[\"level\"] - break_price) / risk_b >= 1.5:\n1354\t                sell_b = r[\"level\"]\n1355\t                break\n1356\t\n1357\t        rr_b = round((sell_b - break_price) / risk_b, 2) if risk_b > 0 else None\n1358\t\n1359\t        lr_condition_b = \"突破日放量(LR≥1.2)\"\n1360\t        lr_met_b = lr is not None and lr >= 1.2\n1361\t\n1362\t        plans.append({\n1363\t            \"name\": \"方案B: 突破买入\",\n1364\t            \"strategy\": \"breakout\",\n1365\t            \"buy_zone\": f\"≥{break_price}\",\n1366\t            \"buy_target\": break_price,\n1367\t            \"sell_target\": sell_b,\n1368\t            \"stop_loss\": stop_b,\n1369\t            \"rr\": rr_b,\n1370\t            \"lr_condition\": lr_condition_b,\n1371\t            \"lr_met\": lr_met_b,\n1372\t            \"lr_current\": lr,\n1373\t            \"conditions\": [\n1374\t                f\"放量突破{break_price}(MA5+1%)\",\n1375\t                f\"突破日LR≥1.2(丰水期)\",\n1376\t                f\"composite_shock≤2\",\n1377\t                f\"当日涨>5%不追(突破日除外)\",\n1378\t            ],\n1379\t        })\n1380\t\n1381\t    # ====== 推荐哪个方案 ======\n1382\t    # v0.90新增：乖离率检查影响推荐\n1383\t    bias_info = trend.get(\"bias\", {})\n1384\t    bias_risk = bias_info.get(\"risk\", \"NORMAL\") if bias_info.get(\"ok\") else \"NORMAL\"\n1385\t\n1386\t    recommendation = \"观望，暂无合适方案\"\n1387\t    if plans:\n1388\t        # v0.90新增：极端过热时禁止推荐买入\n1389\t        if bias_risk == \"EXTREME_OVERHEAT\":\n1390\t            recommendation = f\"⚠️极端过热(乖离{bias_info.get('max_bias', 0):+.1f}%)，禁止开新仓，持仓者考虑减仓\"\n1391\t        elif bias_risk == \"OVERHEAT\":\n1392\t            non_blocked = [p for p in plans if not p.get(\"blocked\")]\n1393\t            if non_blocked:\n1394\t                recommendation = f\"⚠️过热(乖离{bias_info.get('max_bias', 0):+.1f}%)，仅限减仓后观察，不新增仓位\"\n1395\t            else:\n1396\t                recommendation = f\"⚠️过热+{plans[0].get('block_reason', '信号异常')}，观望\"\n1397\t        elif is_bullish:\n1398\t            non_blocked = [p for p in plans if not p.get(\"blocked\")]\n1399\t            if non_blocked:\n1400\t                recommendation = f\"推荐{non_blocked[0]['name']}(多头排列优先回踩)\"\n1401\t            elif plans:\n1402\t                recommendation = f\"⚠️回踩方案被拦截：{plans[0].get('block_reason', '')}，观望\"\n1403\t        else:\n1404\t            breakout = [p for p in plans if p[\"strategy\"] == \"breakout\"]\n1405\t            if breakout:\n1406\t                recommendation = f\"推荐{breakout[0]['name']}(非多头排列等突破确认)\"\n1407\t            else:\n1408\t                recommendation = f\"推荐{plans[0]['name']}\"\n1409\t\n1410\t    return {\n1411\t        \"ok\": True,\n1412\t        \"strategy\": \"回踩\" if is_bullish else (\"回踩/突破均可\" if is_neutral else \"突破\"),\n1413\t        \"trend_verdict\": tv,\n1414\t        \"plans\": plans,\n1415\t        \"recommendation\": recommendation,\n1416\t        \"pullback_vs_breakdown\": pb_breakdown,\n1417\t        \"bias_risk\": bias_risk,\n1418\t    }\n1419\t\n1420\t\n1421\tdef analyze_sector_sync(code, pool_meta=None) -> dict:\n1422\t    \"\"\"⑦ 板块联动：所属板块整体涨跌、是否共振。\"\"\"\n1423\t    config_sector = dl.find_sector_of(code, pool_meta)\n1424\t    sb = dl.get_sector_board()\n1425\t    if not sb.get(\"ok\"):\n1426\t        return {\"verdict\": \"板块数据不可用\", \"detail\": \"\"}\n1427\t\n1428\t    if not config_sector:\n1429\t        return {\"verdict\": \"板块归属未知\", \"detail\": \"个股所属板块未配置(见auto_target_pool.json的sector字段)，无法判断板块联动\"}\n1430\t\n1431\t    # 用别名映射匹配板块\n1432\t    matched = dl.match_sector_in_board(config_sector, sb[\"sectors\"])\n1433\t    total = len(sb[\"sectors\"])\n1434\t    if not matched:\n1435\t        return {\"verdict\": \"板块未匹配\", \"detail\": f\"板块「{config_sector}」在新浪板块表里未找到匹配，可在data_layer.py的SECTOR_ALIASES补充映射\"}\n1436\t\n1437\t    sector_name = matched.get(\"name\", config_sector)\n1438\t    sector_pct = matched.get(\"pct\")\n1439\t    # 计算排名\n1440\t    rank = None\n1441\t    for i, s in enumerate(sb[\"sectors\"], 1):\n1442\t        if s.get(\"name\") == sector_name:\n1443\t            rank = i\n1444\t            break\n1445\t\n1446\t    # 板块强弱判定\n1447\t    if rank and total:\n1448\t        if rank <= total * 0.2:\n1449\t            verdict = \"板块强势(领涨)\"\n1450\t            detail = f\"板块「{sector_name}」{sector_pct}%，排名{rank}/{total}，属领涨板块\"\n1451\t        elif rank >= total * 0.8:\n1452\t            verdict = \"板块弱势(领跌)\"\n1453\t            detail = f\"板块「{sector_name}」{sector_pct}%，排名{rank}/{total}，属领跌板块\"\n1454\t        else:\n1455\t            verdict = \"板块中性\"\n1456\t            detail = f\"板块「{sector_name}」{sector_pct}%，排名{rank}/{total}\"\n1457\t\n1458\t    return {\"verdict\": verdict, \"detail\": detail, \"sector\": sector_name, \"sector_pct\": sector_pct, \"rank\": rank}\n1459\t\n1460\t\n1461\tdef synthesize_advice(trend, intraday, volprice, fundflow, rs, levels, sector_sync, price, pool_meta=None, deviation=None, recovery=None, acc_dist=None) -> dict:\n1462\t    \"\"\"⑧ 综合操作建议：把前7维 + 偏离度 + 筹码行为加权合成最终动作。\"\"\"\n1463\t    score = 5  # 基准分5/10\n1464\t    reasons = []\n1465\t\n1466\t    # 趋势加分/减分（权重最高）\n1467\t    tv = trend.get(\"verdict\", \"\")\n1468\t    if \"多头\" in tv and \"强\" in tv:\n1469\t        score += 2\n1470\t        reasons.append(\"趋势多头\")\n1471\t    elif \"多头\" in tv:\n1472\t        score += 1\n1473\t        reasons.append(\"趋势偏多\")\n1474\t    elif \"空头\" in tv and \"强\" in tv:\n1475\t        score -= 3\n1476\t        reasons.append(\"趋势强空头\")\n1477\t    elif \"空头\" in tv:\n1478\t        score -= 2\n1479\t        reasons.append(\"趋势偏空\")\n1480\t\n1481\t    # 相对强弱\n1482\t    rv = rs.get(\"verdict\", \"\")\n1483\t    if \"显著强于大盘\" in rv or \"领涨板块\" in rv:\n1484\t        score += 1\n1485\t        reasons.append(\"相对强势\")\n1486\t    elif \"显著弱于大盘\" in rv or \"掉队\" in rv:\n1487\t        score -= 1\n1488\t        reasons.append(\"相对弱势\")\n1489\t\n1490\t    # 量价\n1491\t    vv = volprice.get(\"verdict\", \"\")\n1492\t    if \"放量\" in vv and \"冰冻\" not in vv and \"枯水\" not in vv:\n1493\t        score += 1\n1494\t        reasons.append(\"量能配合\")\n1495\t    elif \"冰冻\" in vv or \"枯水\" in vv:\n1496\t        score -= 1\n1497\t        reasons.append(\"量能不足\")\n1498\t    if \"顶背离\" in volprice.get(\"detail\", \"\") or \"放量滞涨\" in volprice.get(\"detail\", \"\"):\n1499\t        score -= 1\n1500\t        reasons.append(\"量价背离\")\n1501\t    # v0.90新增：跌而放量(恐慌/出货)减分——修复架构断层\n1502\t    if \"跌而放量\" in volprice.get(\"detail\", \"\") or \"恐慌/出货\" in volprice.get(\"detail\", \"\"):\n1503\t        score -= 2\n1504\t        reasons.append(\"跌而放量(出货信号)\")\n1505\t\n1506\t    # 分时\n1507\t    if intraday.get(\"available\"):\n1508\t        iv = intraday.get(\"verdict\", \"\")\n1509\t        if \"站稳分时线\" in iv or \"偏强\" in iv:\n1510\t            score += 1\n1511\t            reasons.append(\"分时偏强\")\n1512\t        elif \"跌破分时线\" in iv or \"偏弱\" in iv:\n1513\t            score -= 1\n1514\t            reasons.append(\"分时偏弱\")\n1515\t\n1516\t    # 板块\n1517\t    sv = sector_sync.get(\"verdict\", \"\")\n1518\t    if \"板块强势\" in sv:\n1519\t        score += 1\n1520\t        reasons.append(\"板块联动向好\")\n1521\t    elif \"板块弱势\" in sv:\n1522\t        score -= 1\n1523\t        reasons.append(\"板块走弱\")\n1524\t\n1525\t    # 偏离度（第 9 维）：过热扣分、滞涨加分（需结合板块强弱）\n1526\t    if deviation and deviation.get(\"ok\"):\n1527\t        dev_status = deviation.get(\"status\", \"\")\n1528\t        if dev_status == \"OVERHEAT\":\n1529\t            score -= 2\n1530\t            reasons.append(f\"个股领涨板块{deviation.get('deviation','')}%，过热见顶风险\")\n1531\t        elif dev_status == \"WEAK\":\n1532\t            score -= 1\n1533\t            reasons.append(f\"个股独立走弱{deviation.get('deviation','')}%，破位风险\")\n1534\t        elif dev_status == \"LAGGING\":\n1535\t            # 滞涨的解读取决于板块强弱\n1536\t            if \"板块强势\" in sv:\n1537\t                score += 1\n1538\t                reasons.append(\"滞涨但板块强势，补涨候选\")\n1539\t            elif \"板块弱势\" in sv:\n1540\t                score -= 1\n1541\t                reasons.append(\"滞涨且板块弱势，独立走弱前兆\")\n1542\t\n1543\t    # 暴跌修复率（第 6 个健康度指标，v0.85新增）\n1544\t    if recovery and recovery.get(\"health_score\") is not None:\n1545\t        rh = recovery[\"health_score\"]\n1546\t        score += rh\n1547\t        rv_txt = recovery.get(\"verdict\", \"\")\n1548\t        if rh >= 2:\n1549\t            reasons.append(f\"暴跌已修复({rv_txt})\")\n1550\t        elif rh == 1:\n1551\t            reasons.append(f\"暴跌修复中({rv_txt})\")\n1552\t        else:\n1553\t            reasons.append(f\"暴跌未修复({rv_txt})\")\n1554\t\n1555\t    # 筹码行为分析（v0.85新增：收集 vs 派发）\n1556\t    # v0.86修复：派发惩罚加重+硬规则禁止派发时建议买入\n1557\t    chip_distribution_detected = False\n1558\t    if acc_dist and acc_dist.get(\"ok\"):\n1559\t        ad_score = acc_dist.get(\"score\", 0)\n1560\t        ad_verdict = acc_dist.get(\"verdict\", \"\")\n1561\t        if ad_score >= 2:\n1562\t            score += 1\n1563\t            reasons.append(f\"筹码收集({ad_verdict})\")\n1564\t        elif ad_score <= -1:  # v0.86: 从<=-2改为<=-1，匹配\"派发\"判定条件\n1565\t            score -= 2  # v0.86: 惩罚从-1增加到-2\n1566\t            reasons.append(f\"筹码派发({ad_verdict})，主力出货信号\")\n1567\t            chip_distribution_detected = True\n1568\t\n1569\t    # 月历板块偏好加分（第二批新增：个股所属板块属于当月偏好板块则加分）\n1570\t    try:\n1571\t        import monthly_regime\n1572\t        regime = monthly_regime.get_today_regime()\n1573\t        sector_name = sector_sync.get(\"sector\") or \"\"\n1574\t        if sector_name and monthly_regime.is_sector_favored(sector_name, regime):\n1575\t            score += 1\n1576\t            reasons.append(f\"当月偏好板块({sector_name})\")\n1577\t    except Exception:\n1578\t        pass\n1579\t\n1580\t    # 限定范围\n1581\t    score = max(1, min(10, score))\n1582\t\n1583\t    # 动作映射\n1584\t    lv = levels\n1585\t    if score >= 8:\n1586\t        action = \"加仓/买入\"\n1587\t    elif score >= 6:\n1588\t        action = \"持有/回踩可加仓\"\n1589\t    elif score >= 4:\n1590\t        action = \"持有/观望\"\n1591\t    elif score >= 2:\n1592\t        action = \"减仓/不追\"\n1593\t    else:\n1594\t        action = \"清仓/止损\"\n1595\t\n1596\t    # v0.86硬规则：筹码派发时禁止建议买入，最高只能\"持有/观望\"\n1597\t    if chip_distribution_detected:\n1598\t        if action in [\"加仓/买入\", \"持有/回踩可加仓\"]:\n1599\t            action = \"持有/观望（筹码派发中，禁止加仓）\"\n1600\t\n1601\t    return {\n1602\t        \"action\": action,\n1603\t        \"entry_price\": f\"{lv.get('support')}-{lv.get('support',0)*1.01:.2f}\" if lv.get(\"support\") else None,\n1604\t        \"add_price\": lv.get(\"support\"),\n1605\t        \"reduce_price\": lv.get(\"resistance\"),\n1606\t        \"stop_loss\": lv.get(\"stop_loss\"),\n1607\t        \"reason\": \"，\".join(reasons) if reasons else \"各维度信号中性\",\n1608\t        \"score\": score,\n1609\t    }\n1610\t\n1611\t\n1612\t# =========================================================\n1613\t# 主诊断入口\n1614\t# =========================================================\n1615\tdef diagnose(code: str, pool_meta: dict | None = None) -> dict:\n1616\t    \"\"\"对单只股票执行完整8维诊断。\n1617\t\n1618\t    Args:\n1619\t        code: 股票代码（6位数字）\n1620\t        pool_meta: 可选，来自 auto_target_pool.json 的标的元信息（含 sector/stop_loss 等）。\n1621\t                   若未传，会自动从 auto_target_pool.json 查找匹配项。\n1622\t\n1623\t    Returns:\n1624\t        完整诊断 dict（结构见 md_renderer.render_diagnosis）\n1625\t    \"\"\"\n1626\t    code = dl._clean_code(code)\n1627\t    diag_time = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n1628\t    data_gaps = []\n1629\t\n1630\t    # 单股模式：若未传 pool_meta，自动从持仓池查（用于补 sector/stop_loss）\n1631\t    if pool_meta is None:\n1632\t        pool_meta = _lookup_pool_meta(code)\n1633\t\n1634\t    # 拉数据\n1635\t    snap = dl.get_stock_realtime(code)\n1636\t    hist = dl.get_stock_hist(code, 120)\n1637\t\n1638\t    if not snap.get(\"ok\") and not hist.get(\"ok\"):\n1639\t        return {\"ok\": False, \"code\": code, \"error\": \"实时行情和日K均获取失败，无法诊断\"}\n1640\t\n1641\t    price = snap.get(\"price\")\n1642\t    name = snap.get(\"name\") or (pool_meta.get(\"name\") if pool_meta else \"\") or \"\"\n1643\t\n1644\t    # 8 维诊断\n1645\t    trend = analyze_trend(price, hist)\n1646\t    intraday = analyze_intraday(code)\n1647\t    volprice = analyze_volume_price(snap if snap.get(\"ok\") else None, hist)\n1648\t    fundflow = analyze_fund_flow(snap if snap.get(\"ok\") else None, hist)\n1649\t    rs = analyze_relative_strength(snap if snap.get(\"ok\") else None, code, pool_meta)\n1650\t    levels = calc_key_levels(price, hist, pool_meta)\n1651\t    sector_sync = analyze_sector_sync(code, pool_meta)\n1652\t\n1653\t    # 第 8.5 维：筹码行为分析（v0.85新增：判断放量是收集还是出货）\n1654\t    intraday_raw = dl.get_intraday(code)  # 原始分时数据（含买卖盘性质）\n1655\t    acc_dist = analyze_accumulation_distribution(\n1656\t        code,\n1657\t        snap if snap.get(\"ok\") else None,\n1658\t        hist,\n1659\t        intraday_data=intraday_raw if intraday_raw.get(\"ok\") else None,\n1660\t        trend=trend,\n1661\t    )\n1662\t\n1663\t    # 第 9 维：个股-板块偏离度检测（Top-Down 补充）\n1664\t    deviation = {}\n1665\t    try:\n1666\t        import stock_sector_deviation as ssd_mod\n1667\t        deviation = ssd_mod.diagnose_deviation(code, pool_meta.get(\"sector\") if pool_meta else None)\n1668\t    except Exception:\n1669\t        deviation = {\"ok\": False, \"error\": \"偏离度检测模块加载失败\"}\n1670\t\n1671\t    # 第 10 维：量价信号硬规则判断（v0.8新增：区分恐慌出货/缩量阴跌）\n1672\t    vp_signal = check_volume_price_signal(\n1673\t        code,\n1674\t        snap if snap.get(\"ok\") else None,\n1675\t        hist\n1676\t    )\n1677\t\n1678\t    # 第 10.5 维：暴跌修复率（v0.85新增：距近20日低点的修复程度）\n1679\t    recovery = calc_recovery_rate(hist)\n1680\t\n1681\t    advice = synthesize_advice(trend, intraday, volprice, fundflow, rs, levels, sector_sync, price, pool_meta, deviation=deviation, recovery=recovery, acc_dist=acc_dist)\n1682\t\n1683\t    # 第 11.5 维：交易价格计算（v0.85新增：回踩/突破策略+R:R）\n1684\t    trade_prices = calc_trade_prices(hist, levels, trend, lr=hist.get(\"lr\"), volprice=volprice, price=price)\n1685\t\n1686\t    # 第 12 维：交易纪律检查（v0.8新增：卖出理由审计+仓位铁律+止损位检查）\n1687\t    discipline = trading_discipline.check_sell_discipline(\n1688\t        action=advice.get(\"action\", \"\"),\n1689\t        price=price,\n1690\t        stop_loss=levels.get(\"stop_loss\"),\n1691\t        prev_close=snap.get(\"prev_close\") if snap else None,\n1692\t        market_risk=False,  # 需要外部传入（如美债破5%）\n1693\t        logic_invalidated=False,  # 需要外部传入\n1694\t    )\n1695\t    # 如果纪律检查不通过，修改建议\n1696\t    if not discipline.get(\"ok\"):\n1697\t        modified_action = trading_discipline.integrate_with_advice(\n1698\t            advice.get(\"action\", \"\"),\n1699\t            discipline\n1700\t        )\n1701\t        advice[\"action\"] = modified_action\n1702\t        advice[\"discipline_warning\"] = True\n1703\t\n1704\t    # 记录数据缺口\n1705\t    if not snap.get(\"ok\") or snap.get(\"source\") == \"daily_close_fallback\":\n1706\t        data_gaps.append(\"实时行情不可用，使用上一交易日收盘价，盘中请以实际盘面为准\")\n1707\t    if fundflow.get(\"_degraded\"):\n1708\t        data_gaps.append(\"资金流接口被限流，资金动向为基于量价的降级推断\")\n1709\t    if not intraday.get(\"available\"):\n1710\t        data_gaps.append(\"分时数据不可用（盘后或接口被限流），分时形态维度缺失\")\n1711\t    if not rs.get(\"comparison\", {}).get(\"sector_pct\"):\n1712\t        data_gaps.append(\"个股所属板块未配置或板块表未匹配，相对板块强弱缺失（请在auto_target_pool.json补充sector字段）\")\n1713\t    if acc_dist.get(\"_degraded\"):\n1714\t        data_gaps.append(\"筹码行为分析部分降级(分时买卖盘分类不可用，使用tick方向推断)\")\n1715\t\n1716\t    return {\n1717\t        \"ok\": True,\n1718\t        \"code\": code,\n1719\t        \"name\": name,\n1720\t        \"diag_time\": diag_time,\n1721\t        \"data_source\": snap.get(\"source\", \"\"),\n1722\t        \"snapshot\": snap,\n1723\t        \"trend\": trend,\n1724\t        \"intraday\": intraday,\n1725\t        \"volume_price\": volprice,\n1726\t        \"volume_price_signal\": vp_signal,  # v0.8新增：量价信号硬规则\n1727\t        \"trading_discipline\": discipline,  # v0.8新增：交易纪律检查\n1728\t        \"fund_flow\": fundflow,\n1729\t        \"relative_strength\": rs,\n1730\t        \"levels\": levels,\n1731\t        \"sector_sync\": sector_sync,\n1732\t        \"accumulate_distribution\": acc_dist,  # v0.85新增：筹码收集/派发分析\n1733\t        \"deviation\": deviation,\n1734\t        \"recovery\": recovery,  # v0.85新增：暴跌修复率\n1735\t        \"trade_prices\": trade_prices,  # v0.85新增：回踩/突破策略价格\n1736\t        \"advice\": advice,\n1737\t        \"data_gaps\": data_gaps,\n1738\t    }\n1739\t\n1740\t\n1741\tdef _lookup_pool_meta(code: str) -> dict | None:\n1742\t    \"\"\"从 auto_target_pool.json 查找某代码的元信息（sector/stop_loss 等）。\"\"\"\n1743\t    pool_path = DATABASE_DIR / \"auto_target_pool.json\"\n1744\t    if not pool_path.exists():\n1745\t        return None\n1746\t    try:\n1747\t        pool = json.loads(pool_path.read_text(encoding=\"utf-8\"))\n1748\t        for item in pool:\n1749\t            if dl._clean_code(item.get(\"ticker\", \"\")) == code:\n1750\t                return item\n1751\t    except Exception:\n1752\t        return None\n1753\t    return None\n1754\t\n1755\t\n1756\tdef resolve_code(user_input: str) -> tuple[str, str]:\n1757\t    \"\"\"把用户输入解析为 (代码, 名称)。支持三种输入：\n1758\t\n1759\t    - 纯数字代码：\"300502\" → (\"300502\", \"新易盛\")\n1760\t    - 带前缀代码：\"sz300502\" → (\"300502\", \"新易盛\")\n1761\t    - 中文名称：\"新易盛\" → (\"300502\", \"新易盛\")  （从全市场行情反查）\n1762\t\n1763\t    返回 (code, name)。查不到返回 (\"\", \"\")。\n1764\t    \"\"\"\n1765\t    s = (user_input or \"\").strip()\n1766\t    if not s:\n1767\t        return \"\", \"\"\n1768\t\n1769\t    # 1) 纯数字或带sz/sh前缀 → 直接当代码\n1770\t    digits = dl._clean_code(s)\n1771\t    if digits and digits == s.replace(\"sh\", \"\").replace(\"sz\", \"\").replace(\"SH\", \"\").replace(\"SZ\", \"\"):\n1772\t        # 是代码，反查名称\n1773\t        all_q = dl.get_realtime_quotes()\n1774\t        if all_q.get(\"ok\") and digits in all_q[\"quotes\"]:\n1775\t            return digits, all_q[\"quotes\"][digits].get(\"name\", \"\")\n1776\t        # 持仓池里找名称\n1777\t        meta = _lookup_pool_meta(digits)\n1778\t        return digits, (meta.get(\"name\", \"\") if meta else \"\")\n1779\t\n1780\t    # 2) 中文名称 → 从全市场行情反查代码\n1781\t    all_q = dl.get_realtime_quotes()\n1782\t    if all_q.get(\"ok\"):\n1783\t        for code, q in all_q[\"quotes\"].items():\n1784\t            name = q.get(\"name\", \"\")\n1785\t            if name and (name == s or s in name or name in s):\n1786\t                return dl._clean_code(code), name\n1787\t\n1788\t    # 3) 持仓池里按名称找\n1789\t    pool_path = DATABASE_DIR / \"auto_target_pool.json\"\n1790\t    if pool_path.exists():\n1791\t        try:\n1792\t            pool = json.loads(pool_path.read_text(encoding=\"utf-8\"))\n1793\t            for item in pool:\n1794\t                if item.get(\"name\", \"\") == s or s in item.get(\"name\", \"\"):\n1795\t                    return dl._clean_code(item.get(\"ticker\", \"\")), item.get(\"name\", \"\")\n1796\t        except Exception:\n1797\t            pass\n1798\t\n1799\t    return \"\", \"\"\n1800\t\n1801\t\n1802\tdef diagnose_pool() -> list[dict]:\n1803\t    \"\"\"诊断 auto_target_pool.json 里全部标的。\"\"\"\n1804\t    pool_path = DATABASE_DIR / \"auto_target_pool.json\"\n1805\t    if not pool_path.exists():\n1806\t        return []\n1807\t    pool = json.loads(pool_path.read_text(encoding=\"utf-8\"))\n1808\t    results = []\n1809\t    for item in pool:\n1810\t        code = item.get(\"ticker\", \"\")\n1811\t        if not code:\n1812\t            continue\n1813\t        try:\n1814\t            r = diagnose(code, pool_meta=item)\n1815\t            results.append(r)\n1816\t        except Exception as e:\n1817\t            results.append({\"ok\": False, \"code\": code, \"error\": f\"{type(e).__name__}: {e}\"})\n1818\t    return results\n1819\t\n1820\t\n1821\t# =========================================================\n1822\t# 命令行入口\n1823\t# =========================================================\n1824\tdef main():\n1825\t    parser = argparse.ArgumentParser(description=\"盘中个股8维快速诊断\")\n1826\t    parser.add_argument(\"code\", nargs=\"?\", default=\"\", help=\"股票代码或名称，如 300502 或 新易盛\")\n1827\t    parser.add_argument(\"--pool\", action=\"store_true\", help=\"诊断 auto_target_pool.json 全部标的\")\n1828\t    parser.add_argument(\"--push\", action=\"store_true\", help=\"诊断结果推送到飞书\")\n1829\t    parser.add_argument(\"--save\", action=\"store_true\", help=\"保存诊断报告到 database/\")\n1830\t    args = parser.parse_args()\n1831\t\n1832\t    if args.pool:\n1833\t        # 池模式\n1834\t        print(\"=\" * 60)\n1835\t        print(\"🚀 持仓池自动巡航诊断\")\n1836\t        print(\"=\" * 60)\n1837\t        results = diagnose_pool()\n1838\t        if not results:\n1839\t            print(\"持仓池为空或文件不存在\")\n1840\t            return\n1841\t\n1842\t        # 汇总\n1843\t        summary = md_renderer.render_pool_summary(results)\n1844\t        print(\"\\n\" + summary)\n1845\t\n1846\t        # 各股明细\n1847\t        for r in results:\n1848\t            if r.get(\"ok\"):\n1849\t                print(\"\\n\" + \"=\" * 60)\n1850\t                print(md_renderer.render_diagnosis(r))\n1851\t\n1852\t        if args.push:\n1853\t            import feishu_pusher\n1854\t            feishu_pusher.send_md(f\"持仓池诊断汇总 {datetime.now().strftime('%m-%d %H:%M')}\", summary)\n1855\t        return\n1856\t\n1857\t    if not args.code:\n1858\t        parser.print_help()\n1859\t        print('\\n示例：\\n  python stock_diagoser.py 300502        # 按代码\\n  python stock_diagoser.py 新易盛         # 按名称\\n  python stock_diagoser.py 新易盛 --push  # 诊断+推送飞书\\n  python stock_diagoser.py --pool          # 诊断全部持仓池')\n1860\t        return\n1861\t\n1862\t    # 解析输入：支持代码(300502)或名称(新易盛)\n1863\t    code, name = resolve_code(args.code)\n1864\t    if not code:\n1865\t        print(f\"❌ 无法识别「{args.code}」，请输入6位代码或股票名称\")\n1866\t        return\n1867\t    display = f\"{name}({code})\" if name else code\n1868\t\n1869\t    # 单股模式\n1870\t    print(f\"🔍 正在诊断 {display} ...\")\n1871\t    result = diagnose(code)\n1872\t    if not result.get(\"ok\"):\n1873\t        print(f\"❌ 诊断失败：{result.get('error')}\")\n1874\t        return\n1875\t\n1876\t    md = md_renderer.render_diagnosis(result)\n1877\t    print(\"\\n\" + md)\n1878\t\n1879\t    if args.save:\n1880\t        today = datetime.now().strftime(\"%Y-%m-%d\")\n1881\t        out = DATABASE_DIR / f\"diagnosis_{code}_{today}.md\"\n1882\t        out.write_text(md, encoding=\"utf-8\")\n1883\t        print(f\"\\n💾 已保存：{out}\")\n1884\t\n1885\t    if args.push:\n1886\t        import feishu_pusher\n1887\t        name = result.get(\"name\", \"\") or name\n1888\t        feishu_pusher.send_md(f\"{name}({code}) 诊断 {datetime.now().strftime('%H:%M')}\", md)\n1889\t        print(\"\\n📤 已推送到飞书\")\n1890\t\n1891\t\n1892\tif __name__ == \"__main__\":\n1893\t    main()\n1894\t"}]},"uuid":"a8c3285e-b6f8-4930-b2e8-dfe7100b8b12","timestamp":"2026-08-14T01:22:34.473Z","toolUseResult":{"type":"text","file":{"filePath":"F:\\软件-图书仓库\\skills\\a-stock-quantimental\\scripts\\stock_diagoser.py","content":"
